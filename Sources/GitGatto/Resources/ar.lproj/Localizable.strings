"help.title" = "GitGatto مساعدة";
"help.short_title" = "دليل المستخدم";
"help.menu.guide" = "دليل المستخدم";
"help.topic.gettingStarted.title" = "البدء";
"help.topic.gettingStarted.summary" = "أدخل مساحة العمل من مستودع محلي أو مشروع GitHub. يستخدم كل تغيير والتزام وإجراء عن بعد المشروع الذي حددته بالفعل.";
"help.gettingStarted.open.title" = "فتح مشروع";
"help.gettingStarted.open.1" = "اضغط على ⌘O واختر أي مجلد داخل مستودع Git موجود؛ GitGatto يحل جذر المستودع الخاص به.";
"help.gettingStarted.open.2" = "تقوم المشاريع بتحميل المستودعات المتاحة لحساب GitHub الحالي ويمكنها البحث عنها أو تفرعها أو استنساخها محليًا.";
"help.gettingStarted.open.3" = "يبدأ المسح فقط عند الطلب. في المسح والإضافة، قم بمسح هذا الجهاز أو المجلدات المحددة، ثم اختر المشاريع التي تريد إدارتها فقط. يؤدي إغلاق نافذة الفحص إلى ترك المهمة قيد التشغيل في الخلفية.";
"help.gettingStarted.navigation.title" = "التنقل في مساحة العمل";
"help.gettingStarted.navigation.1" = "تحتوي المشاريع على GitHub طلبات البحث والتوثيق والتعليمات البرمجية والسحب؛ التغييرات تحتوي على تعديلات محلية.";
"help.gettingStarted.navigation.2" = "يقوم السجل والفروع دائمًا بقراءة المستودع المحلي المحدد؛ استخدم قائمة الفرع الحالي في الشريط العلوي لتبديل الفروع المحلية مباشرة.";
"help.gettingStarted.navigation.3" = "Agent يرتبط بالمستودع المحلي الحالي ويظهر اسم المشروع الحقيقي والعدد المرحلي في الرأس.";

"help.topic.changes.title" = "التغييرات والتدريج";
"help.topic.changes.summary" = "قم بمراجعة حالة شجرة العمل واختلاف الملف تلو الآخر، ثم حدد بالضبط ما ينتمي إلى الالتزام التالي.";
"help.changes.stage.title" = "تنظيم منطقة التدريج";
"help.changes.stage.1" = "تظهر الملفات المرحلية وغير المرحلية في مجموعات منفصلة؛ حدد ملفًا لفحص الاختلافات الخاصة به سطرًا تلو الآخر.";
"help.changes.stage.2" = "انقل الملفات باستخدام إجراء الصف أو قائمة السياق أو Stage All وUnstage All.";
"help.changes.stage.3" = "تحديثات المراقبة المباشرة للمجموعات المرحلية وغير المرحلية في الفاصل الزمني الذي تم تكوينه، بما في ذلك أثناء عمل Agent.";
"help.changes.files.title" = "إجراءات الملف";
"help.changes.files.1" = "انقر بزر الماوس الأيمن لتجاهل التغييرات أو إضافة قواعد .gitignore أو نسخ المسارات أو الكشف عن ملف في Finder.";
"help.changes.files.2" = "يقوم Discard باستعادة الملفات المتعقبة إلى HEAD ونقل الملفات الجديدة إلى سلة المهملات؛ التأكيد يشرح التأثير.";
"help.changes.files.3" = "افتح الملف الحالي في Xcode أو تطبيقه الافتراضي دون تغيير حالة المستودع.";

"help.topic.sync.title" = "الالتزام والمزامنة";
"help.topic.sync.summary" = "تحتوي الالتزامات على محتوى مرحلي فقط. يتم السحب والدفع فقط من الإجراءات الصريحة والإبلاغ عن حالتها طوال العملية.";
"help.sync.commit.title" = "أنشئ التزامًا";
"help.sync.commit.1" = "أدخل رسالة أو استخدم المسودة واملأها بـ Agent. عندما لا يتم تنظيم أي شيء، يتم تنظيم التغييرات الحالية أولاً؛ يتبع التنسيق الموجز أو الكامل الإعدادات.";
"help.sync.commit.2" = "بعد الصياغة، قم بتحرير الرسالة، أو إنشاء التزام محلي، أو الالتزام والدفع. لا تزال عمليات التنفيذ والكتابة عن بعد تتطلب زرًا صريحًا.";
"help.sync.commit.3" = "يتم إعادة تحميل مساحة العمل بعد الالتزام. إذا فشلت الدفعة التالية، فسيظل الالتزام المحلي سليمًا.";
"help.sync.remote.title" = "السحب والدفع";
"help.sync.remote.1" = "تُبلغ الحالة العليا باستمرار عن المزامنة أو الأمام أو الخلف أو المتباعدة أو المفقودة في المنبع وتتحرك أثناء حالة Agent أو السحب أو الدفع النشطة.";
"help.sync.remote.2" = "تنشئ الدفعة الأولى منبعًا للفرع الحالي على جهاز التحكم عن بعد المتوفر، ثم تتبع علاقة التتبع هذه.";
"help.sync.remote.3" = "GitGatto لا يفرض الدفع أو التنظيف أو إعادة كتابة السجل أو حذف الفروع تلقائيًا.";

"help.topic.goals.title" = "أهداف المشروع";
"help.topic.goals.summary" = "احفظ نتيجة التسليم كفحوصات قابلة للاسترداد تستمر من المستودع وحالة GitHub تمت ملاحظتها بالفعل.";
"help.goals.create.title" = "اصنع هدفا";
"help.goals.create.1" = "افتح مستودعًا محليًا، ثم أدخل الأهداف. يمكن أن يحتوي المستودع على هدف واحد غير مكتمل في المرة الواحدة.";
"help.goals.create.2" = "هدف مخصص يطلب من Agent تحويل النتيجة إلى شروط مدعومة. التخطيط للقراءة فقط؛ يتم إنشاء الهدف فقط بعد تأكيد المرشح.";
"help.goals.create.3" = "الأهداف السريعة تغطي الالتزام والدفع، GitHub التسليم، والإفراج الكامل. GitHub التوصيل يتطلب فرع غير الفرع الافتراضي.";
"help.goals.create.4" = "يسجل الهدف مستودعه وفرعه والتزامه الأساسي وخطواته وأدلته. تبديل المستودعات لا يخلط بين حالتها.";
"help.goals.execute.title" = "التشغيل والاسترداد";
"help.goals.execute.1" = "يقوم خيار المتابعة بتشغيل الخطوة القابلة للتنفيذ حاليًا فقط، ثم يعيد تحميل حالة Git وGitHub بعد كل خطوة.";
"help.goals.execute.2" = "الخطوة الفاشلة تحتفظ بدليلها الأصلي وتتوقف عند \"تحتاج إلى الاهتمام\". تبقى الخطوات المكتملة حتى بعد إعادة تشغيل التطبيق.";
"help.goals.execute.3" = "عند فشل الإجراءات، يتوفر إصلاح Agent من تلك الخطوة. لا يزال يتعين التحقق من النتيجة عن بعد بعد الإصلاح.";
"help.goals.execute.4" = "يتوقف الهدف إذا كان الفرع المسحوب يختلف عن الفرع المستهدف. قم بالتبديل مرة أخرى، ثم قم بالتحديث أو المتابعة.";
"help.goals.release.title" = "الدمج والإفراج";
"help.goals.release.1" = "يتحقق الإصدار الكامل من README والترجمة والإصدار والإنشاء وسجل التغيير وسير العمل قبل الالتزام والدفع.";
"help.goals.release.2" = "بعد علامة الإصدار، يتم التحقق من إصدار GitHub وDMG وخلاصة التحديث. يقرأ التحقق من التثبيت إصدار التطبيق المثبت الفعلي.";
"help.goals.release.3" = "يتطلب دمج طلب السحب ونشر الإصدار وتثبيت التطبيق تأكيدًا منفصلاً.";

"help.topic.regression.title" = "تحقيق الانحدار";
"help.topic.regression.summary" = "قم بتضييق نطاق الالتزام في شجرة عمل معزولة، وحدد موقع الالتزام السيئ الأول، واحتفظ بالإصلاح والتحقق وأدلة العلاقات العامة معًا.";
"help.regression.start.title" = "بدء التحقيق";
"help.regression.start.1" = "الخير المعلوم لا بد أن يكون سلفاً للسيئ المعلوم. إما أن يقبل الحد التزامًا أو علامة أو فرعًا؛ الحدود السيئة عادة ما تكون HEAD.";
"help.regression.start.2" = "يحتاج الوضع التلقائي إلى أمر قابل للتكرار. يناسب الوضع اليدوي حالات الفشل التي تتطلب واجهة مستخدم أو جهازًا أو مراقبة بشرية.";
"help.regression.start.3" = "GitGatto يستخدم شجرة عمل Git معزولة ومنصف دون تبديل الفرع أو الرأس في المستودع الحالي.";
"help.regression.start.4" = "يمكن إيقاف التحقيق مؤقتًا واستئنافه من نفس شجرة العمل والتزام المرشح بعد إعادة فتح التطبيق.";
"help.regression.verdict.title" = "الأحكام الآلية واليدوية";
"help.regression.verdict.1" = "في الوضع التلقائي، رمز الخروج 0 جيد، 1-124 سيئ، و125 يتخطى الالتزام الحالي.";
"help.regression.verdict.2" = "يؤدي رمز الخروج 126 أو 127 أو 128 وما فوق إلى إيقاف التحقيق بالمخرجات الأصلية بدلاً من تصنيف الالتزام بشكل خاطئ.";
"help.regression.verdict.3" = "يقدم الوضع اليدوي مرشحًا واحدًا في كل مرة. اختر \"جيد\" أو \"سيئ\" أو \"تخطي\" للتقدم في نفس جلسة النصف.";
"help.regression.fix.title" = "الإصلاح والدليل";
"help.regression.fix.1" = "تحتفظ النتيجة بأول التزام سيء وملخصه وسجل النصف ومدة كل مسبار ورمز الخروج والمخرجات.";
"help.regression.fix.2" = "الإصلاح بـ Agent يعمل فقط على الفرع المعزول. يمكنك أيضًا الكشف عن شجرة العمل هذه وتحريرها بنفسك.";
"help.regression.fix.3" = "الوضع التلقائي يعيد تشغيل الأمر الأصلي؛ يتطلب الوضع اليدوي تمريرًا صريحًا أو فشلًا. لا يمكن إنشاء العلاقات العامة قبل مرور الإصلاح.";
"help.regression.fix.4" = "الالتزام وإنشاء العلاقات العامة يلتزم بالفرع المعزول، ويدفع الأصل، وينشئ GitHub PR. تؤدي إزالة شجرة العمل إلى الاحتفاظ بأدلتها.";

"help.topic.github.title" = "GitHub المشاريع";
"help.topic.github.summary" = "ابحث عن المشاريع والمطورين، واقرأ الوثائق الكاملة والتعليمات البرمجية في التطبيق، واعمل مع طلبات السحب.";
"help.github.discover.title" = "اكتشاف المشاريع والحصول عليها";
"help.github.discover.1" = "التبديل بين المشاريع والبحث عن الأشخاص. تستخدم نتائج المستخدم تصنيفًا غامضًا وتتضمن مستودعات عامة.";
"help.github.discover.2" = "تتضمن مشروعاتي المستودعات المملوكة والتعاونية والتنظيمية؛ تأتي اللقطات اليومية من بيانات GitHub الحالية.";
"help.github.discover.3" = "يحتفظ Clone محليًا بمستودع المصدر. يقوم Fork & Clone أولاً بإنشاء شوكة في الحساب الحالي، ثم تنزيله.";
"help.github.detail.title" = "تفاصيل المشروع";
"help.github.detail.1" = "نظرة عامة تعرض README من GitHub Markdown HTML، بما في ذلك الجداول والتعليمات البرمجية والتنبيهات والصور.";
"help.github.detail.2" = "تتنقل وثائق المستودع وروابط التعليمات البرمجية داخل تفاصيل المشروع؛ تستخدم الصفحات الخارجية المتصفح داخل التطبيق.";
"help.github.detail.3" = "الكود يتصفح الفرع الافتراضي حسب المجلد ويعرض الملفات النصية؛ يمكن فتح الملفات الثنائية على GitHub داخل التطبيق.";
"help.github.detail.4" = "تعرض طلبات السحب الأوصاف والاختلافات، وتسمح لـ Agent بصياغة رد، ولا يتم نشرها إلا بعد التأكيد.";
"help.github.detail.5" = "أعد كتابة README باستخدام أحد القوالب الأربعة وراجع النتيجة المحلية المقدمة على الفور. الالتزام والتطبيق يلتزم فقط بـ README ويدفع الفرع الحالي.";

"help.topic.agent.title" = "Agent";
"help.topic.agent.summary" = "Agent يستخدم CLI المحلي الذي تم تكوينه لفهم المستودع الحالي وتنفيذ المهام والاحتفاظ بالمحادثات على مستوى المشروع.";
"help.agent.scope.title" = "حدود المستودع";
"help.agent.scope.1" = "يستطيع المحترف Git و GitHub Agent فحص شجرة العمل والتدريج والتصحيحات والتاريخ والفروع والصراعات وطلبات السحب و GitHub أدلة الإجراءات.";
"help.agent.scope.2" = "المراجعات المرحلية والالتزام بالمسودات قم أولاً بتحديث المشروع المحدد، ثم اقرأ الفرق الحقيقي لـ git --cached.";
"help.agent.scope.3" = "Agent لا يقوم بالدفع أو السحب أو تغيير أجهزة التحكم عن بعد أو إدارة بيانات الاعتماد؛ تمتلك عناصر التحكم الصريحة في التطبيق تلك الإجراءات.";
"help.agent.workflow.title" = "المحادثة والنتائج";
"help.agent.workflow.1" = "يمكن للمهام السريعة شرح التغييرات أو مراجعة المراحل أو صياغة رسالة التزام، ويمكنك إدخال طلب محدد مباشرة.";
"help.agent.workflow.2" = "تستخدم الردود تنسيق المحادثة؛ تظل الأوامر وتغييرات الملفات والوضع ووقت الانتهاء مع كل نتيجة.";
"help.agent.workflow.3" = "يحتوي كل مستودع محلي على سجل محادثة منفصل يتم إرجاعه عند إعادة فتح المشروع.";
"help.agent.workflow.4" = "مسودة من مساحة العمل Agent أو مباشرة أسفل التدريج؛ يمكن تكوين التنسيقات المختصرة والكاملة، ويتم ملء الملحن تلقائيًا.";

"help.topic.translation.title" = "الترجمة";
"help.topic.translation.summary" = "يتم تشغيل الترجمة السريعة وترجمة مستندات المشروع بشكل مستقل عن Agent وتحتفظ بترجمات README القابلة لإعادة الاستخدام.";
"help.translation.document.title" = "ترجمة المستندات";
"help.translation.document.1" = "README الترجمة ترسل النص المرئي فقط؛ يظل HTML والتعليمات البرمجية والروابط وعناوين الأصول دون تغيير ويتم استعادتها في مكانها.";
"help.translation.document.2" = "يتم تحديد الترجمات حسب المستودع والمسار واللغة الهدف ومحتوى المصدر، لذلك لا تعيد المستندات التي تم تغييرها استخدام النص القديم أبدًا.";
"help.translation.document.3" = "التبديل بين النسخة الأصلية والصينية والإنجليزية من شريط الأدوات؛ الترجمات المحفوظة لا تتصل بالرقم CLI مرة أخرى.";
"help.translation.channel.title" = "حارة التنفيذ المستقلة";
"help.translation.channel.1" = "الترجمة CLI والمشروع Agent لهما تكوين وعمليات منفصلة، لذلك تظل الترجمة متاحة أثناء عمل Agent.";
"help.translation.channel.2" = "يقوم الملحن وترجمة README بمشاركة مسار الترجمة ومعالجة مهمة ترجمة واحدة في كل مرة.";
"help.translation.channel.3" = "يمكن إيقاف الترجمة ولها مهلة زمنية؛ الفشل لا يؤدي إلى حذف الترجمات المحفوظة بالفعل.";

"help.topic.cliSettings.title" = "الإعدادات";
"help.topic.cliSettings.summary" = "تكوين واجهة التطبيق ومساحة عمل بدء التشغيل والمراقبة المباشرة Git وAgent والترجمة من نافذة واحدة.";
"help.cliSettings.providers.title" = "التطبيق و Git";
"help.cliSettings.providers.1" = "يتحكم المظهر في الوضع الفاتح والداكن، وموضوعات الواجهة الكاملة، واللهجات المعدة مسبقًا أو المخصصة. يقوم النسق بتغيير تخطيط النافذة ومواد اللوحة وتصميم التحكم معًا.";
"help.cliSettings.providers.2" = "ضوابط عامة على لغة الواجهة ومساحة عمل بدء التشغيل وإعادة فتح آخر مستودع محلي؛ حفظ وفحص يستمر في هذه التفضيلات.";
"help.cliSettings.providers.3" = "Git & روابط المزامنة للمسح اليدوي، وتحديث التدريج المحلي، وتحديث المنبع للقراءة فقط، وتجاهل التأكيد؛ فهو لا يقوم أبدًا بالمسح أو السحب أو الدفع تلقائيًا.";
"help.cliSettings.arguments.title" = "Agent والترجمة";
"help.cliSettings.arguments.1" = "Agent يختار صياغة التزام موجزة أو كاملة ويقوم بتكوين منفذ المشروع الخاص به.";
"help.cliSettings.arguments.2" = "للترجمة منفذ، وعملية، ووسيطات منفصلة، ​​لذلك تظل متاحة أثناء عمل Agent.";
"help.cliSettings.arguments.3" = "غطاء الإعدادات المسبقة Codex CLI، Claude Code، Gemini CLI، وOpenCode؛ يقبل المخصص أي CLI متوافق مع وسيطة واحدة في كل سطر.";
"help.cliSettings.arguments.4" = "GitGatto يعيد استخدام معلومات تسجيل الدخول المحلية الخاصة بكل CLI ولا يقرأ أو يخزن بيانات الاعتماد الخاصة به مطلقًا.";

"help.topic.shortcuts.title" = "اختصارات لوحة المفاتيح";
"help.topic.shortcuts.summary" = "تنقل في التطبيق وقم بتشغيل إجراءات المستودع الشائعة مباشرة من لوحة المفاتيح.";
"help.shortcuts.workspace.title" = "تبديل مساحات العمل";
"help.shortcuts.workspace.1" = "⌘1: المشاريع";
"help.shortcuts.workspace.2" = "⌘2: التغييرات";
"help.shortcuts.workspace.3" = "⌘3: التاريخ";
"help.shortcuts.workspace.4" = "⌘4: الفروع؛ ⌘5: Agent";
