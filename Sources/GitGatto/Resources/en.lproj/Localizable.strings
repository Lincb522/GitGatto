"codex.prompt.diagnose_conflicts" = "Inspect whether the repository is in a merge, rebase, cherry-pick, revert, or stash conflict and list the conflict boundaries and safe resolution order. Do not modify the repository.";
"codex.prompt.trace_history" = "Trace recent changes, branch relationships, and likely regression sources from repository history with verifiable commit and file evidence. Do not modify the repository.";
"codex.prompt.diagnose_github_checks" = "Read the current repository's pull request and GitHub Actions check results and identify the failing step and its relationship to local changes. Keep GitHub read-only.";
