"help.title" = "GitGatto Help";
"help.short_title" = "User Guide";
"help.menu.guide" = "User Guide";
"help.topic.gettingStarted.title" = "Getting Started";
"help.topic.gettingStarted.summary" = "Enter the workspace from a local repository or GitHub project. Every change, commit, and remote action uses the project you actually selected.";
"help.gettingStarted.open.title" = "Open a project";
"help.gettingStarted.open.1" = "Press ⌘O and choose any folder inside an existing Git repository; GitGatto resolves its repository root.";
"help.gettingStarted.open.2" = "Projects loads repositories available to the current GitHub account and can search, fork, or clone them locally.";
"help.gettingStarted.open.3" = "Scanning starts only when requested. In Scan & Add, scan this device or selected folders, then choose only the projects to manage. Closing the scan window leaves the task running in the background.";
"help.gettingStarted.navigation.title" = "Workspace navigation";
"help.gettingStarted.navigation.1" = "Projects contains GitHub search, documentation, code, and pull requests; Changes contains local modifications.";
"help.gettingStarted.navigation.2" = "History and Branches always read the selected local repository; use the current-branch menu in the top bar to switch local branches directly.";
"help.gettingStarted.navigation.3" = "Agent binds to the current local repository and shows its real project name and staged count in the header.";

"help.topic.changes.title" = "Changes & Staging";
"help.topic.changes.summary" = "Review working-tree state and diffs file by file, then decide exactly what belongs in the next commit.";
"help.changes.stage.title" = "Organize the staging area";
"help.changes.stage.1" = "Staged and unstaged files appear in separate groups; select a file to inspect its line-by-line diff.";
"help.changes.stage.2" = "Move files with the row action, context menu, or Stage All and Unstage All.";
"help.changes.stage.3" = "Live monitoring updates staged and unstaged groups at the configured interval, including while Agent is working.";
"help.changes.files.title" = "File actions";
"help.changes.files.1" = "Right-click to discard changes, add .gitignore rules, copy paths, or reveal a file in Finder.";
"help.changes.files.2" = "Discard restores tracked files to HEAD and moves new files to Trash; the confirmation explains the impact.";
"help.changes.files.3" = "Open the current file in Xcode or its default application without changing repository state.";

"help.topic.sync.title" = "Commit & Sync";
"help.topic.sync.summary" = "Commits contain only staged content. Pull and push run only from explicit actions and report their state throughout the operation.";
"help.sync.commit.title" = "Create a commit";
"help.sync.commit.1" = "Enter a message or use Draft & Fill with Agent. When nothing is staged, the current changes are staged first; the concise or complete format follows Settings.";
"help.sync.commit.2" = "After drafting, edit the message, create a local commit, or commit and push. Commits and remote writes still require an explicit button.";
"help.sync.commit.3" = "The workspace reloads after a commit. If the following push fails, the local commit remains intact.";
"help.sync.remote.title" = "Pull and push";
"help.sync.remote.1" = "The top status continuously reports synced, ahead, behind, diverged, or missing upstream and animates while status, Agent, pull, or push work is active.";
"help.sync.remote.2" = "The first push establishes an upstream for the current branch on an available remote, then follows that tracking relationship.";
"help.sync.remote.3" = "Branch management and commit-history editing are explicit actions with confirmations and checks. Check the selected remote and branch before sending changes; refreshing status does not push or pull for you.";

"help.topic.goals.title" = "Project Goals";
"help.topic.goals.summary" = "Save a delivery result as recoverable checks that continue from the repository and GitHub state actually observed.";
"help.goals.create.title" = "Create a goal";
"help.goals.create.1" = "Open a repository, choose a quick action in Goals, enter a commit message or version, then select Start. One goal runs per repository at a time.";
"help.goals.create.2" = "For a custom goal, describe the outcome. Agent proposes steps using read-only analysis. Review the scope, then select Start.";
"help.goals.create.3" = "Quick goals cover commit and push, GitHub delivery, and complete release. GitHub delivery requires a branch other than the default branch.";
"help.goals.create.4" = "The goal records its repository, branch, baseline commit, steps, and evidence. Switching repositories does not mix their state. Create goals from changes, an Issue, a PR, or a failed check. You can select a saved project command as a verification step before committing.";
"help.goals.execute.title" = "Run and recover";
"help.goals.execute.1" = "Starting runs authorized steps in sequence, rereading Git and GitHub state after each step. Merge, release and installation wait for confirmation.";
"help.goals.execute.2" = "A failed step retains its original evidence and stops at Needs Attention. Completed steps survive an app restart.";
"help.goals.execute.3" = "Use Repair and continue after an Actions failure. A successful repair resumes only in the same repository and branch. Cancellation, failure or a protection review stops execution.";
"help.goals.execute.4" = "A goal stops if the checked-out branch differs from its target branch. Switch back, then refresh or continue.";
"help.goals.release.title" = "Merge and release";
"help.goals.release.1" = "A complete release checks the README and translation, version and build, changelog, and release workflow before committing and pushing.";
"help.goals.release.2" = "After the release tag, it verifies the GitHub Release, DMG, and update feed. Install verification reads the actual installed app version.";
"help.goals.release.3" = "Merging a pull request, publishing a release, and installing the app each require separate confirmation.";

"help.topic.regression.title" = "Regression Investigation";
"help.topic.regression.summary" = "Narrow a commit range in an isolated worktree, locate the first bad commit, and retain the fix, verification, and PR evidence together.";
"help.regression.start.title" = "Start an investigation";
"help.regression.start.1" = "Known good must be an ancestor of known bad. Either boundary accepts a commit, tag, or branch; the bad boundary is commonly HEAD.";
"help.regression.start.2" = "Automatic mode needs a repeatable command. Manual mode fits failures that require a UI, device, or human observation.";
"help.regression.start.3" = "GitGatto uses an isolated Git worktree and bisect without switching the branch or HEAD in the current repository.";
"help.regression.start.4" = "An investigation can be paused and resumes from the same worktree and candidate commit after the app reopens.";
"help.regression.verdict.title" = "Automatic and manual verdicts";
"help.regression.verdict.1" = "In automatic mode, exit code 0 is good, 1–124 is bad, and 125 skips the current commit.";
"help.regression.verdict.2" = "Exit code 126, 127, or 128 and above stops the investigation with the original output instead of misclassifying a commit.";
"help.regression.verdict.3" = "Manual mode presents one candidate at a time. Choose Good, Bad, or Skip to advance the same bisect session.";
"help.regression.fix.title" = "Fix and evidence";
"help.regression.fix.1" = "The result retains the first bad commit, its summary, the bisect log, and each probe's duration, exit code, and output.";
"help.regression.fix.2" = "Fix with Agent works only on the isolated branch. You can also reveal that worktree and edit it yourself.";
"help.regression.fix.3" = "Automatic mode reruns the original command; manual mode requires an explicit pass or fail. A PR cannot be created before the fix passes.";
"help.regression.fix.4" = "Commit and Create PR commits the isolated branch, pushes origin, and creates a GitHub PR. Removing the worktree retains its evidence.";

"help.topic.github.title" = "GitHub Projects";
"help.topic.github.summary" = "Search projects and developers, read complete documentation and code in the app, and work with pull requests.";
"help.github.discover.title" = "Discover and obtain projects";
"help.github.discover.1" = "Switch between Projects and People search. User results use fuzzy ranking and include public repositories.";
"help.github.discover.2" = "My Projects includes owned, collaborative, and organization repositories; Daily Picks comes from current GitHub data.";
"help.github.discover.3" = "Clone Locally keeps the source repository. Fork & Clone first creates a fork in the current account, then downloads it.";
"help.github.detail.title" = "Project details";
"help.github.detail.1" = "Overview renders the README from GitHub Markdown HTML, including tables, code, alerts, and images.";
"help.github.detail.2" = "Repository documentation and code links navigate inside project details; external pages use the in-app browser.";
"help.github.detail.3" = "Code browses the default branch by folder and shows text files; binary files can open on GitHub inside the app.";
"help.github.detail.4" = "Pull Requests shows descriptions and diffs, lets Agent draft a reply, and publishes only after confirmation.";
"help.github.detail.5" = "Rewrite a README with one of four templates and review the rendered local result immediately. Commit & Apply commits only the README and pushes the current branch.";

"help.topic.agent.title" = "Agent";
"help.topic.agent.summary" = "Agent uses your configured local CLI to understand the current repository, perform tasks, and retain project-level conversations.";
"help.agent.scope.title" = "Repository boundary";
"help.agent.scope.1" = "The professional Git and GitHub Agent can inspect working tree, staging, patches, history, branches, conflicts, pull requests, and GitHub Actions evidence.";
"help.agent.scope.2" = "Staged reviews and commit drafts first refresh the selected project, then read the real git diff --cached.";
"help.agent.scope.3" = "Agent does not push, pull, change remotes, or manage credentials; explicit app controls own those actions.";
"help.agent.workflow.title" = "Conversation and results";
"help.agent.workflow.1" = "Quick tasks can explain changes, review staging, or draft a commit message, and you can enter a specific request directly.";
"help.agent.workflow.2" = "Replies use conversational formatting; commands, file changes, mode, and completion time stay with each result.";
"help.agent.workflow.3" = "Each local repository has separate conversation history that returns when the project is reopened.";
"help.agent.workflow.4" = "Draft from the Agent workspace or directly below staging; concise and complete formats are configurable, and the composer is filled automatically.";

"help.topic.translation.title" = "Translation";
"help.topic.translation.summary" = "Prompt and project-document translation run independently from Agent and retain reusable README translations.";
"help.translation.document.title" = "Document translation";
"help.translation.document.1" = "README translation sends visible text only; HTML, code, links, and asset addresses remain unchanged and are restored in place.";
"help.translation.document.2" = "Translations are keyed by repository, path, target language, and source content, so changed documents never reuse stale text.";
"help.translation.document.3" = "The translation menu switches between the original and supported target languages, not just English and Chinese. Unchanged cached translations can be reused; translating does not commit a rewritten README.";
"help.translation.channel.title" = "Independent execution lane";
"help.translation.channel.1" = "Translation CLI and project Agent have separate configuration and processes, so translation remains available while Agent works.";
"help.translation.channel.2" = "Automatic translation detects readable text and uses the configured target. Text already in that language, or too short to detect, may remain unchanged. If nothing happens, check the translation provider and target in Settings.";
"help.translation.channel.3" = "Translation can be stopped and has a timeout; failures do not delete translations already saved. Retry uses the language of the failed request. Original content remains available when translation fails.";

"help.topic.cliSettings.title" = "Settings";
"help.topic.cliSettings.summary" = "Configure the app interface, startup workspace, live Git monitoring, Agent, and translation from one window.";
"help.cliSettings.providers.title" = "App and Git";
"help.cliSettings.providers.1" = "Appearance controls light and dark mode, complete interface themes, and preset or custom accents. A theme changes window layout, panel materials, and control styling together. Lumen also lets you edit background, panel, text, button, and status colors separately for light and dark mode. Preview a preset or your changes, then apply the colors to save them, or reset to defaults.";
"help.cliSettings.providers.2" = "General settings control startup, window closing, and interface language. Language changes take effect immediately. Use Save & Check for other edited settings; appearance, monitoring, and recovery have their own settings sections.";
"help.cliSettings.providers.3" = "Git & Sync links to manual scanning, local staging refresh, read-only upstream refresh, and discard confirmation; it never scans, pulls, or pushes automatically.";
"help.cliSettings.arguments.title" = "Agent and translation";
"help.cliSettings.arguments.1" = "Agent selects concise or complete commit drafting and configures its project executor.";
"help.cliSettings.arguments.2" = "Translation has a separate executor, process, and arguments, so it remains available while Agent works.";
"help.cliSettings.arguments.3" = "Presets cover Codex CLI, Claude Code, Gemini CLI, and OpenCode; Custom accepts any compatible CLI with one argument per line.";
"help.cliSettings.arguments.4" = "GitGatto reuses each CLI's own local sign-in and never reads or stores its credentials.";

"help.topic.shortcuts.title" = "Keyboard Shortcuts";
"help.topic.shortcuts.summary" = "Navigate the app and run common repository actions directly from the keyboard.";
"help.shortcuts.workspace.title" = "Switch workspaces";
"help.shortcuts.workspace.1" = "⌘1: Projects";
"help.shortcuts.workspace.2" = "⌘2: Changes";
"help.shortcuts.workspace.3" = "⌘3: History";
"help.shortcuts.workspace.4" = "⌘4: Branches; ⌘5: Agent";
"help.shortcuts.workspace.5" = "⌘?: Open GitGatto Help";
"help.shortcuts.actions.title" = "Common actions";
"help.shortcuts.actions.1" = "⌘O: Open a local repository; ⌘R: Refresh the current repository.";
"help.shortcuts.actions.2" = "⌘↩: Commit staged content with the current commit message.";
"help.shortcuts.actions.3" = "⌘K opens the command palette. Right-click a changed file or recent repository for its actions; Help → Help for Current Workspace opens its guide. Pin frequently used commands; recently used entries move to the top. Use arrow keys to select and Return to run.";

"help.topic.troubleshooting.title" = "Troubleshooting";
"help.topic.troubleshooting.summary" = "Confirm the selected project, local CLI sign-in, and reported error before retrying the failed operation.";
"help.troubleshooting.access.title" = "CLI and account access";
"help.troubleshooting.access.1" = "If GitHub is unavailable, start sign-in from Projects or complete gh auth login in Terminal.";
"help.troubleshooting.access.2" = "If Agent is unavailable, check its executable, version arguments, and the CLI's own local sign-in under Settings > Agent.";
"help.troubleshooting.access.3" = "If a custom CLI has no version command, clear Version Check; Save & Check still verifies that the executable exists.";
"help.troubleshooting.operations.title" = "Failed operations";
"help.troubleshooting.operations.1" = "If a project is missing, use Scan for Projects; repositories the current user cannot read, write, and traverse are not added. For stale staging, confirm the selected project and refresh.";
"help.troubleshooting.operations.2" = "A failed push leaves its local commit in place. Resolve remote, permission, or network issues, then use Push again.";
"help.troubleshooting.operations.3" = "Repositories using Git LFS require git-lfs; remove the repository's LFS hook if LFS is no longer used.";
"help.troubleshooting.operations.4" = "Retry a timed-out or stopped translation; saved translations remain selectable while the source is unchanged.";
"help.troubleshooting.operations.5" = "Git and Agent failures retain the complete output, error code, and exit code; use Copy Diagnostics when you need to investigate.";

