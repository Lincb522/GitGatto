/* Task guides */
"help.task.start" = "How to use";
"help.task.result" = "Results and next steps";
"help.task.caution" = "Limits and recovery";
"help.current_workspace" = "Help for Current Workspace";
"help.gettingStarted.tools" = "Open Project tools from the top toolbar, or press ⌘K to find code search, work scenes, run commands, ignore rules, and commit identities. Each tool has a help button; Help → Help for Current Workspace opens the current workspace guide.";
"help.topic.history.title" = "Commit History";
"help.topic.history.summary" = "Inspect, compare, and edit commits.";
"help.history.start" = "Open Commit History, select a commit, and inspect its files and diff. Use Compare to choose two references. The commit menu offers cherry-pick, revert, message editing, squash, fixup, split, drop, and reset; Reorder Local Commits changes replay order.";
"help.history.result" = "Revert creates a new undo commit. Soft reset keeps changes staged; mixed reset keeps files but clears staging; hard reset discards changes. Splitting pauses Git: create replacement commits, then continue the operation.";
"help.history.caution" = "History editing can change commit hashes. Published commits are blocked by the rewrite checks. Save current work first, read the confirmation, and resolve conflicts before continuing or aborting; do not repeatedly rerun the original action.";
"help.topic.fileHistory.title" = "File History";
"help.topic.fileHistory.summary" = "Find when a file or line changed.";
"help.fileHistory.start" = "Open File History and select a file, then a revision. Inspect its content and diff, or use line attribution to locate the commit and author behind a line.";
"help.fileHistory.result" = "Preview the difference before restoring a file. Confirm to replace the working file; if it has changed since preview, refresh the preview first.";
"help.fileHistory.caution" = "If the expected file is missing, check the selected repository, path, and history filters. For lost uncommitted work, inspect recovery points or stashes instead of assuming Git history contains it.";
"help.topic.branches.title" = "Branches, Tags & Remotes";
"help.topic.branches.summary" = "Manage references and recover a recorded commit.";
"help.branches.start" = "Open Branches and choose Branches, Tags, Remotes, or Recovery. Select an item before switching, renaming, setting upstream, merging, rebasing, creating a tag, or editing a remote.";
"help.branches.result" = "Fetching updates remote-tracking references without merging into your files. Tag push and remote deletion are separate actions. In Recovery, choose a reflog record and create a branch to inspect that commit.";
"help.branches.caution" = "Safe branch deletion checks merge status; forced deletion can remove unmerged references. Reflog is local and expires, so it is not a backup. Verify the remote and target before deleting or rewriting anything.";
"help.topic.stash.title" = "Stashes";
"help.topic.stash.summary" = "Put unfinished changes aside and restore them later.";
"help.stash.start" = "Open Stashes, create a stash, and review its files before restoring it. Check the include-untracked option when new files also need saving; ignored files are not included by that option.";
"help.stash.result" = "Apply restores changes and keeps the stash. Pop restores changes and removes the stash on success. Drop deletes the saved entry without applying its content.";
"help.stash.caution" = "Restoration may conflict with current files. Resolve the conflict and inspect the remaining stash before retrying. A stash belongs to the local repository; it is neither pushed to GitHub nor an independent recovery backup.";
"help.topic.worktrees.title" = "Worktrees";
"help.topic.worktrees.summary" = "Work on another branch in a separate directory.";
"help.worktrees.start" = "Open Worktrees, create one with its branch and destination, then open it from the list. Each worktree has separate checked-out files while sharing the repository's Git objects.";
"help.worktrees.result" = "The worktree panel can run Agent against that directory and show its result. Compare and inspect changes before deciding how to bring them into your main work.";
"help.worktrees.caution" = "Commit or save changes before removal. Force removal may discard files; deleting a worktree is not merging its changes. A branch already checked out in another worktree cannot be checked out twice.";
"help.topic.recovery.title" = "Recovery Center";
"help.topic.recovery.summary" = "Create, inspect, restore, and manage local recovery points.";
"help.recovery.start" = "Open a managed local repository and enter Recovery Center. Choose Back Up Now, or enable scheduled and major-change backups in Settings → Recovery. Adjust thresholds and file limits there.";
"help.recovery.result" = "Select a recovery point to inspect its source, time, size, and change counts. Restore Copy writes to a new destination, not over the source repository. Manage Backups can reveal or delete one repository's backups or all backups.";
"help.recovery.caution" = "Each repository retains at most three rotating backups; limits can omit files. Changing the backup location in Settings migrates existing backups. A guard alert is a detected change to review, not proof of an attack; inspect the reported reason and recovery point before restoring.";
"help.topic.monitoring.title" = "Monitoring & Menu Bar";
"help.topic.monitoring.summary" = "Check repository changes, upstream state, protection, Actions, and goals.";
"help.monitoring.start" = "In Settings → Monitoring, enable the engine and choose each channel and refresh interval separately. The menu-bar visibility switch is also there; hiding the icon is not the same as stopping monitoring. Each repository can use Automatic, Active, or Low frequency. Battery limits and urgent protection checks still apply.";
"help.monitoring.result" = "Open the menu-bar panel and select All Repositories or one repository independently of the main window. It shows actual changes, sync state, recovery points, and daily activity. Activity combines commits and change signals, not coding hours.";
"help.monitoring.caution" = "Monitoring after quitting requires the background service to be enabled and allowed by macOS. Monitoring pauses during sleep and logout. External Agent and CLI protection observes managed repositories and retains recovery baselines; it cannot intercept every destructive command or guarantee recovery of unsaved or excluded files.";
"help.topic.applications.title" = "Application Repository";
"help.topic.applications.summary" = "Find releases, download assets, and install applications.";
"help.applications.start" = "Open Application Repository → Applications. Search or browse discovery, favorites, installed, and recent items. Select an app, then inspect Versions & Downloads and choose an asset matching your platform and architecture.";
"help.applications.result" = "Download saves the asset; Quick Install also starts installation after confirmation. Packages requiring command-line work are handed to Agent. Download Manager shows transfer and installation progress, logs, and retry actions.";
"help.applications.caution" = "The Installed collection records installations made through GitGatto, not every app on the Mac. An upstream release may lack a compatible asset. If installation fails, inspect its log and requirements before retrying; downloading alone does not mean installation succeeded.";
"help.topic.developerTools.title" = "Developer Tools";
"help.topic.developerTools.summary" = "Install, configure, detect, and upgrade local tools.";
"help.developerTools.start" = "Open Application Repository → Developer Tools and refresh local detection. Select a tool for Agent Install or Upgrade; select multiple upgradable tools for a batch. Installation and upgrade queues show waiting and running jobs.";
"help.developerTools.result" = "Up to three tasks can run concurrently, while package-manager write locks may make individual steps wait. Open a job to inspect its current phase and output. Installation includes required user configuration such as PATH and plugin registration, followed by local executable and version checks. Tool bundles enqueue selected tools. Expand the installation scope before starting; the receipt separates executable verification, PATH changes, and Agent configuration results.";
"help.developerTools.caution" = "Agent saying 'done' is not verification. Action Required means installation, configuration, or version checks remain unresolved. Use Authorize and Retry when offered for a permission problem. Account sign-in and macOS authorization still require you; being signed out alone does not make a verified installation fail. Do not delete Homebrew locks while another job is running.";
"help.topic.collaboration.title" = "Sync, Inbox, Issues & PRs";
"help.topic.collaboration.summary" = "Handle multiple repositories and GitHub conversations.";
"help.collaboration.start" = "In Projects, use Sync, Inbox, or Issues. Refresh repository state before selecting a batch sync action. Filter the inbox by category; select an Issue to inspect its discussion, edit it, or create a local branch.";
"help.collaboration.result" = "Issue and PR reply composers can ask Agent for a draft. Review and edit the draft, then explicitly send it. PR review and Actions live in the selected GitHub project's detail tabs; inspect checks and logs before merging or retrying a workflow.";
"help.collaboration.caution" = "Sign in with an account allowed to access the repository. Batch results are per repository: resolve failed items without rerunning successful ones blindly. If a workflow-file push is rejected for OAuth scope, reauthorize GitHub with workflow permission; pulling cannot grant that permission.";
"help.topic.diagnostics.title" = "Environment Diagnostics";
"help.topic.diagnostics.summary" = "Check repository tooling, Git LFS, and hooks.";
"help.diagnostics.start" = "Open Environment Diagnostics for a local repository and run the checks. Inspect each result rather than treating one passing item as a complete clean bill of health.";
"help.diagnostics.result" = "Where offered, configure Git LFS or repair a hook's execution permission, then run the checks again. Open the hooks directory to inspect scripts before running unfamiliar code.";
"help.diagnostics.caution" = "A missing executable belongs in Developer Tools; a sign-in failure needs the corresponding account login. Diagnostics does not automatically install every dependency or repair arbitrary repository damage. Keep the reported command and failure reason when asking Agent to investigate.";
"help.topic.codeSearch.title" = "Code search";
"help.topic.codeSearch.summary" = "Search managed repositories, a revision, or commit history.";
"help.codeSearch.start" = "Open Project Tools → Code search, or find it with ⌘K. Enter literal text, choose one or all managed local repositories and the working-tree, revision, or history scope. Narrow by directory, language, extension, or filename where available.";
"help.codeSearch.result" = "Select a match to inspect its bounded preview; open a current file or send the evidence to Agent as a draft. Revision search accepts a branch, tag, or commit. History searches commit changes rather than the current checkout.";
"help.codeSearch.caution" = "Search is not a regular expression. Results and previews are capped, and known sensitive paths are excluded. A limit warning or partial repository error means the result is incomplete; narrow the query or repair that repository and search again. Sending a draft does not start Agent.";
"help.topic.workScenes.title" = "Work scenes";
"help.topic.workScenes.summary" = "Save current changes and context before switching tasks.";
"help.workScenes.start" = "Open Project Tools → Work Scenes, name the scene, and choose Save and leave a clean workspace. This stashes staged, unstaged, and untracked changes and saves the branch, selected file, drafts, goal, and related link. Ignored files are not saved.";
"help.workScenes.result" = "Restore returns to the recorded branch and reapplies the saved state only when the working tree is clean, no Git operation is in progress, and that branch has not moved. Create a separate worktree from the scene if the current checkout must stay untouched.";
"help.workScenes.caution" = "If restoration is blocked or interrupted, inspect the phase and repository before retrying. Marking a scene as handled only acknowledges it; it does not restore files. Deleting a scene removes its record and private reference, but leaves the original stash available in Stashes.";
"help.topic.projectCommands.title" = "Run commands";
"help.topic.projectCommands.summary" = "Run and inspect a project's development commands.";
"help.projectCommands.start" = "Open Project Tools → Run commands. Review the executable, directory, arguments and timeout before running. Enter each custom argument separately; spaces stay inside that argument.";
"help.projectCommands.result" = "Pin common commands and inspect live output, elapsed time, and exit status. Stop or retry a run, open reported localhost links, or send output to Agent as a draft. Closing the panel leaves commands running; quitting the app stops its owned processes.";
"help.projectCommands.caution" = "Commands are noninteractive: use a terminal for password prompts or interactive setup. A timeout is not success. Only the latest 20 run records remain in memory for the current session; save needed output before quitting. Do not run scripts from an untrusted project without reviewing them.";
"help.topic.ignoreRules.title" = "Ignore rules";
"help.topic.ignoreRules.summary" = "Explain ignored files and preview rule changes.";
"help.ignoreRules.start" = "Open Project Tools → Ignore Rules and inspect a path to see its matching rule, source file, and line. Choose repository .gitignore for shared rules or local .git/info/exclude for rules that should stay on this Mac.";
"help.ignoreRules.result" = "Edit rules, preview affected files, then save. If rules changed externally or the draft changed after preview, reload or preview again before saving. Nested and global rules still affect the result.";
"help.ignoreRules.caution" = "Adding a rule does not untrack a committed file. Stop Tracking removes the path from the index while preserving its disk copy, after confirmation; review that staged deletion before committing. Never confuse this with deleting the file.";
"help.topic.identities.title" = "Commit identities";
"help.topic.identities.summary" = "Choose commit authors and inspect effective Git identity.";
"help.identities.start" = "Open Project Tools → Commit identities. Create a name/email profile with an optional public signing-key identifier, then bind it to a repository or directory. Inspect the effective values and their configuration sources.";
"help.identities.result" = "Directory bindings use Git includeIf rules. Before a commit, the identity check compares the actual author, including environment overrides, with the selected profile. Resolve a mismatch at its reported source rather than changing unrelated global settings.";
"help.identities.caution" = "Commit identity is separate from GitHub login and remote permissions. Profiles do not store private keys or tokens; signing still requires your configured key and tooling. Removing a profile cleans its owned bindings, not unrelated Git configuration.";

