"help.gettingStarted.navigation.1" = "Proyectos contiene GitHub búsqueda, documentación, código y solicitudes de extracción; Los cambios contienen modificaciones locales.";
"help.gettingStarted.navigation.2" = "Historial y Sucursales siempre leen el repositorio local seleccionado; use el menú de la sucursal actual en la barra superior para cambiar de sucursal local directamente.";
"help.gettingStarted.navigation.3" = "Agent se vincula al repositorio local actual y muestra el nombre real del proyecto y el recuento de etapas en el encabezado.";

"help.topic.changes.title" = "Cambios y puesta en escena";
"help.topic.changes.summary" = "Revise el estado del árbol de trabajo y las diferencias archivo por archivo, luego decida exactamente qué pertenece a la siguiente confirmación.";
"help.changes.stage.title" = "Organizar el área de preparación";
"help.changes.stage.1" = "Los archivos preparados y no preparados aparecen en grupos separados; seleccione un archivo para inspeccionar su diferencia línea por línea.";
"help.changes.stage.2" = "Mueva archivos con la acción de fila, el menú contextual o Preparar todo y Desorganizar todo.";
"help.changes.stage.3" = "El monitoreo en vivo actualiza los grupos preparados y no preparados en el intervalo configurado, incluso mientras Agent está funcionando.";
"help.changes.files.title" = "Acciones de archivos";
"help.changes.files.1" = "Haga clic derecho para descartar cambios, agregar reglas .gitignore, copiar rutas o revelar un archivo en Finder.";
"help.changes.files.2" = "Descartar restaura los archivos rastreados en HEAD y mueve los archivos nuevos a la Papelera; la confirmación explica el impacto.";
"help.changes.files.3" = "Abra el archivo actual en Xcode o su aplicación predeterminada sin cambiar el estado del repositorio.";

"help.topic.sync.title" = "Confirmar y sincronizar";
"help.topic.sync.summary" = "Las confirmaciones contienen solo contenido preparado. Pull y push run solo a partir de acciones explícitas e informan su estado durante toda la operación.";
"help.sync.commit.title" = "Crear una confirmación";
"help.sync.commit.1" = "Ingrese un mensaje o use Borrar y completar con Agent. Cuando no se prepara nada, los cambios actuales se realizan primero; el formato conciso o completo sigue Configuración.";
"help.sync.commit.2" = "Después de redactar el borrador, edite el mensaje, cree una confirmación local o confirme y envíe. Las confirmaciones y escrituras remotas aún requieren un botón explícito.";
"help.sync.commit.3" = "El espacio de trabajo se recarga después de una confirmación. Si la siguiente inserción falla, la confirmación local permanece intacta.";
"help.sync.remote.title" = "Tirar y empujar";
"help.sync.remote.1" = "El estado superior informa continuamente sincronizado, adelantado, retrasado, divergido o faltante en sentido ascendente y se anima mientras el estado, Agent, extracción o inserción está activo.";
"help.sync.remote.2" = "La primera inserción establece un flujo ascendente para la rama actual en un control remoto disponible y luego sigue esa relación de seguimiento.";
"help.sync.remote.3" = "GitGatto no fuerza la inserción, limpia, reescribe el historial ni elimina ramas automáticamente.";

"help.topic.goals.title" = "Objetivos del proyecto";
"help.topic.goals.summary" = "Guardar un resultado de entrega como cheques recuperables que continúan desde el repositorio y el estado GitHub realmente observado.";
"help.goals.create.title" = "Crear una meta";
"help.goals.create.1" = "Abra un repositorio local y luego ingrese Metas. Un repositorio sólo puede tener un objetivo sin terminar a la vez.";
"help.goals.create.2" = "Un objetivo personalizado solicita a Agent que convierta el resultado en condiciones admitidas. La planificación es de sólo lectura; el objetivo se crea solo después de confirmar al candidato.";
"help.goals.create.3" = "Los objetivos rápidos cubren el compromiso y el envío, la entrega GitHub y la liberación completa. GitHub la entrega requiere una sucursal distinta a la sucursal predeterminada.";
"help.goals.create.4" = "El objetivo registra su repositorio, rama, confirmación de referencia, pasos y evidencia. Cambiar de repositorio no mezcla su estado.";
"help.goals.execute.title" = "Ejecutar y recuperar";
"help.goals.execute.1" = "Continuar ejecuta solo el paso procesable actualmente, luego recarga el estado Git y GitHub después de cada paso.";
"help.goals.execute.2" = "Un paso fallido conserva su evidencia original y se detiene en Necesita atención. Los pasos completados sobreviven al reinicio de la aplicación.";
"help.goals.execute.3" = "Cuando las acciones fallan, la reparación Agent está disponible desde ese paso. El resultado remoto aún debe comprobarse después de la reparación.";
"help.goals.execute.4" = "Un objetivo se detiene si la rama extraída difiere de su rama de destino. Vuelva atrás, luego actualice o continúe.";
"help.goals.release.title" = "Fusionar y liberar";
"help.goals.release.1" = "Una versión completa verifica el README y la traducción, la versión y la compilación, el registro de cambios y el flujo de trabajo de la versión antes de confirmar y enviar.";
"help.goals.release.2" = "Después de la etiqueta de lanzamiento, verifica la versión GitHub, DMG y el feed de actualización. La verificación de instalación lee la versión real de la aplicación instalada.";
"help.goals.release.3" = "La combinación de una solicitud de extracción, la publicación de una versión y la instalación de la aplicación requieren confirmación por separado.";

"help.topic.regression.title" = "Investigación de regresión";
"help.topic.regression.summary" = "Reduzca un rango de confirmación en un árbol de trabajo aislado, ubique la primera confirmación incorrecta y conserve la corrección, la verificación y la evidencia de relaciones públicas juntas.";
"help.regression.start.title" = "Iniciar una investigación";
"help.regression.start.1" = "El bien conocido debe ser un antepasado del mal conocido. Cualquiera de los límites acepta una confirmación, una etiqueta o una rama; el límite incorrecto suele ser HEAD.";
"help.regression.start.2" = "El modo automático necesita un comando repetible. El modo manual se adapta a fallas que requieren una interfaz de usuario, un dispositivo u observación humana.";
"help.regression.start.3" = "GitGatto utiliza un árbol de trabajo Git aislado y lo divide en dos sin cambiar la rama o HEAD en el repositorio actual.";
"help.regression.start.4" = "Una investigación se puede pausar y reanudar desde el mismo árbol de trabajo y confirmación del candidato después de que se vuelva a abrir la aplicación.";
"help.regression.verdict.title" = "Veredictos automáticos y manuales";
"help.regression.verdict.1" = "En modo automático, el código de salida 0 es bueno, 1–124 es malo y 125 omite la confirmación actual.";
"help.regression.verdict.2" = "El código de salida 126, 127 o 128 y superiores detiene la investigación con el resultado original en lugar de clasificar erróneamente una confirmación.";
"help.regression.verdict.3" = "El modo manual presenta un candidato a la vez. Elija Bueno, Malo o Saltar para avanzar en la misma sesión dividida.";
"help.regression.fix.title" = "Solución y evidencia";
"help.regression.fix.1" = "El resultado conserva la primera confirmación incorrecta, su resumen, el registro de bisección y la duración, el código de salida y la salida de cada sondeo.";
"help.regression.fix.2" = "La solución con Agent funciona solo en la rama aislada. También puedes revelar ese árbol de trabajo y editarlo tú mismo.";
"help.regression.fix.3" = "El modo automático vuelve a ejecutar el comando original; El modo manual requiere un aprobado o reprobado explícito. No se puede crear un PR antes de que se apruebe la solución.";
"help.regression.fix.4" = "Confirmar y crear PR confirma la rama aislada, envía el origen y crea un GitHub PR. La eliminación del árbol de trabajo conserva su evidencia.";

"help.topic.github.title" = "GitHub Proyectos";
"help.topic.github.summary" = "Busque proyectos y desarrolladores, lea la documentación y el código completos en la aplicación y trabaje con solicitudes de extracción.";
"help.github.discover.title" = "Descubrir y obtener proyectos";
"help.github.discover.1" = "Cambia entre búsqueda de Proyectos y Personas. Los resultados de los usuarios utilizan una clasificación difusa e incluyen repositorios públicos.";
"help.github.discover.2" = "Mis proyectos incluye repositorios propios, colaborativos y de organización; Las selecciones diarias provienen de datos actuales de GitHub.";
"help.github.discover.3" = "Clonar localmente mantiene el repositorio de origen. Fork & Clone primero crea una bifurcación en la cuenta actual y luego la descarga.";
"help.github.detail.title" = "Detalles del proyecto";
"help.github.detail.1" = "La descripción general representa el README de GitHub Markdown HTML, incluidas tablas, código, alertas e imágenes.";
"help.github.detail.2" = "La documentación del repositorio y los enlaces de código navegan dentro de los detalles del proyecto; Las páginas externas utilizan el navegador de la aplicación.";
"help.github.detail.3" = "El código explora la rama predeterminada por carpeta y muestra archivos de texto; Los archivos binarios se pueden abrir en GitHub dentro de la aplicación.";
"help.github.detail.4" = "Las solicitudes de extracción muestran descripciones y diferencias, permiten que Agent redacte una respuesta y se publica solo después de la confirmación.";
"help.github.detail.5" = "Reescribe un README con una de las cuatro plantillas y revisa el resultado local renderizado inmediatamente. Commit & Apply confirma solo README y empuja la rama actual.";

"help.topic.agent.title" = "Agent";
"help.topic.agent.summary" = "Agent utiliza su CLI local configurado para comprender el repositorio actual, realizar tareas y retener conversaciones a nivel de proyecto.";
"help.agent.scope.title" = "Límite del repositorio";
"help.agent.scope.1" = "El profesional Git y GitHub Agent puede inspeccionar el árbol de trabajo, la preparación, los parches, el historial, las ramas, los conflictos, las solicitudes de extracción y la evidencia de acciones GitHub.";
"help.agent.scope.2" = "Las revisiones preparadas y los borradores confirmados primero actualizan el proyecto seleccionado y luego leen el git diff real --cached.";
"help.agent.scope.3" = "Agent no presiona, tira, cambia controles remotos ni administra credenciales; los controles explícitos de la aplicación son propietarios de esas acciones.";
"help.agent.workflow.title" = "Conversación y resultados";
"help.agent.workflow.1" = "Las tareas rápidas pueden explicar cambios, revisar la preparación o redactar un mensaje de confirmación, y usted puede ingresar una solicitud específica directamente.";
"help.agent.workflow.2" = "Las respuestas utilizan formato conversacional; Los comandos, los cambios de archivos, el modo y el tiempo de finalización permanecen con cada resultado.";
"help.agent.workflow.3" = "Cada repositorio local tiene un historial de conversaciones independiente que regresa cuando se vuelve a abrir el proyecto.";
"help.agent.workflow.4" = "Borrador del espacio de trabajo Agent o directamente debajo de la preparación; Los formatos concisos y completos son configurables y el compositor se completa automáticamente.";

"help.topic.translation.title" = "Traducción";
"help.topic.translation.summary" = "La traducción rápida y de documentos de proyecto se ejecuta independientemente de Agent y conserva las traducciones reutilizables de README.";
"help.translation.document.title" = "Traducción de documentos";
"help.translation.document.1" = "README la traducción envía solo texto visible; El HTML, el código, los enlaces y las direcciones de activos permanecen sin cambios y se restauran en su lugar.";
"help.translation.document.2" = "Las traducciones se codifican por repositorio, ruta, idioma de destino y contenido de origen, por lo que los documentos modificados nunca reutilizan texto obsoleto.";
"help.translation.document.3" = "Cambie entre el original, el chino y el inglés desde la barra de herramientas; Las traducciones guardadas no vuelven a llamar al CLI.";
"help.translation.channel.title" = "Línea de ejecución independiente";
"help.translation.channel.1" = "La traducción CLI y el proyecto Agent tienen configuración y procesos separados, por lo que la traducción permanece disponible mientras Agent funciona.";
"help.translation.channel.2" = "Composer y README traductor comparten la ruta de traducción y procesan una tarea de traducción a la vez.";
"help.translation.channel.3" = "La traducción se puede detener y tiene un tiempo de espera; los fallos no eliminan las traducciones ya guardadas.";

"help.topic.cliSettings.title" = "Configuración";
"help.topic.cliSettings.summary" = "Configure la interfaz de la aplicación, el espacio de trabajo de inicio, el monitoreo Git en vivo, Agent y la traducción desde una ventana.\nAplicación";
"help.cliSettings.providers.title" = "y Git";
"help.cliSettings.providers.1" = "La apariencia controla el modo claro y oscuro, temas de interfaz completos y acentos preestablecidos o personalizados. Un tema cambia el diseño de la ventana, los materiales del panel y el estilo del control al mismo tiempo.";
"help.cliSettings.providers.2" = "Controles generales del idioma de la interfaz, el espacio de trabajo de inicio y la reapertura del último repositorio local; Guardar y verificar conserva estas preferencias.";
"help.cliSettings.providers.3" = "Git y enlaces de sincronización para escaneo manual, actualización de preparación local, actualización ascendente de solo lectura y confirmación de descarte; nunca escanea, tira o empuja automáticamente.";
"help.cliSettings.arguments.title" = "Agent y traducción";
"help.cliSettings.arguments.1" = "Agent selecciona un borrador de compromiso conciso o completo y configura su ejecutor de proyecto.";
"help.cliSettings.arguments.2" = "La traducción tiene un ejecutor, un proceso y argumentos separados, por lo que permanece disponible mientras Agent funciona.";
"help.cliSettings.arguments.3" = "Los ajustes preestablecidos cubren Codex CLI, Claude Code, Gemini CLI y OpenCode; Personalizado acepta cualquier CLI compatible con un argumento por línea.";
"help.cliSettings.arguments.4" = "GitGatto reutiliza el inicio de sesión local de cada CLI y nunca lee ni almacena sus credenciales.";

"help.topic.shortcuts.title" = "Atajos de teclado";
"help.topic.shortcuts.summary" = "Navegue por la aplicación y ejecute acciones comunes del repositorio directamente desde el teclado.";
"help.shortcuts.workspace.title" = "Cambiar espacios de trabajo";
"help.shortcuts.workspace.1" = "⌘1: Proyectos";
"help.shortcuts.workspace.2" = "⌘2: Cambios";
"help.shortcuts.workspace.3" = "⌘3: Historia";
"help.shortcuts.workspace.4" = "⌘4: Sucursales; ⌘5: Agent";
"help.shortcuts.workspace.5" = "⌘?: Abrir GitGatto Ayuda";
"help.shortcuts.actions.title" = "Acciones comunes";
"help.shortcuts.actions.1" = "⌘O: Abrir un repositorio local; ⌘R: Actualiza el repositorio actual.";
"help.shortcuts.actions.2" = "⌘↩: confirma contenido preparado con el mensaje de confirmación actual.";
"help.shortcuts.actions.3" = "Haga clic con el botón derecho en un archivo modificado o en un repositorio reciente para acceder al menú completo específico del objeto.";

"help.topic.troubleshooting.title" = "Solución de problemas";
"help.topic.troubleshooting.summary" = "Confirme el proyecto seleccionado, el inicio de sesión local CLI y el error informado antes de volver a intentar la operación fallida.";
"help.troubleshooting.access.title" = "CLI y acceso a la cuenta";
"help.troubleshooting.access.1" = "Si GitHub no está disponible, comience a iniciar sesión desde Proyectos o complete el inicio de sesión de autenticación gh en la Terminal.";
"help.troubleshooting.access.2" = "Si Agent no está disponible, verifique su ejecutable, los argumentos de la versión y el inicio de sesión local del CLI en Configuración > Agent.";
"help.troubleshooting.access.3" = "Si un CLI personalizado no tiene un comando de versión, borre Verificación de versión; Save & Check aún verifica que el ejecutable exista.";
"help.troubleshooting.operations.title" = "Operaciones fallidas";
"help.troubleshooting.operations.1" = "Si falta un proyecto, utilice Buscar proyectos; Los repositorios que el usuario actual no puede leer, escribir ni recorrer no se agregan. Para una puesta en escena obsoleta, confirme el proyecto seleccionado y actualice.";
"help.troubleshooting.operations.2" = "Un envío fallido deja su compromiso local en su lugar. Resuelva problemas remotos, de permisos o de red y luego use Push nuevamente.";
"help.troubleshooting.operations.3" = "Los repositorios que usan Git LFS requieren git-lfs; elimine el gancho LFS del repositorio si ya no se utiliza LFS.";
"help.troubleshooting.operations.4" = "Vuelva a intentar una traducción detenida o con tiempo de espera agotado; Las traducciones guardadas siguen siendo seleccionables mientras la fuente no se modifica.\nLas fallas";
"help.troubleshooting.operations.5" = "Git y Agent conservan la salida completa, el código de error y el código de salida; utilice Copiar diagnóstico cuando necesite investigar.";

