"codex.prompt.draft_commit.complete" = "Redacte un mensaje de confirmación Git completo a partir de los cambios por etapas: un resumen de no más de 72 caracteres, luego una línea en blanco y de 1 a 3 puntos breves en el cuerpo que expliquen la motivación y el impacto. Devuelve sólo el mensaje de confirmación.";
"codex.prompt.rewrite_commit.concise" = "Reescriba los cambios por etapas actuales como un resumen de confirmación de una línea más preciso y específico Git de no más de 72 caracteres. Devuelve sólo el nuevo mensaje.";
"codex.prompt.rewrite_commit.complete" = "Reescriba los cambios por etapas actuales como un mensaje de confirmación Git completo: un resumen de no más de 72 caracteres y un cuerpo breve que explique la motivación y el impacto. Devuelve sólo el nuevo mensaje.";
"codex.prompt.diagnose_repository" = "Inspeccione el estado actual del repositorio en busca de problemas con el árbol de trabajo, índice, rama, enlace, Git LFS, submódulo o árbol de trabajo y proporcione pasos de recuperación basados ​​en evidencia. No modifique el repositorio.";
"codex.prompt.diagnose_sync" = "Inspeccione el estado actual de rama, aguas arriba y adelante/detrás y diagnostique posibles fallas de extracción o inserción. No realice escrituras remotas.";
"codex.prompt.diagnose_conflicts" = "Inspeccione si el repositorio se encuentra en un conflicto de fusión, cambio de base, selección selectiva, reversión o almacenamiento oculto y enumere los límites del conflicto y el orden de resolución segura. No modifique el repositorio.";
"codex.prompt.trace_history" = "Realice un seguimiento de los cambios recientes, las relaciones entre sucursales y las probables fuentes de regresión a partir del historial del repositorio con evidencia verificable de archivos y confirmaciones. No modifique el repositorio.";
"codex.prompt.diagnose_github_checks" = "Lea la solicitud de extracción del repositorio actual y las acciones GitHub verifican los resultados e identifican el paso fallido y su relación con los cambios locales. Mantenga GitHub como solo lectura.";
