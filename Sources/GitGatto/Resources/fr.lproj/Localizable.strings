"help.intelligence.intent.2" = "Chaque carte affiche un message et ses fichiers. Modifier et répartir permet de réaffecter fichiers et blocs de code. Le menu règle l’ordre ou fusionne les groupes. La planification ne modifie pas le dépôt.";
"help.intelligence.intent.3" = "Autres options permet de définir une commande de vérification après chaque commit. La création enregistre un point de restauration, puis crée les commits locaux dans l’ordre, sans push.";
"help.intelligence.provenance.title" = "Code Context";
"help.intelligence.provenance.1" = "Enter a tracked repository-relative path and a positive line number.";
"help.intelligence.provenance.2" = "Git blame identifies the originating local commit and the files changed by it.";
"help.intelligence.provenance.3" = "When origin and GitHub CLI are available, GitGatto also shows the associated PR, linked issues, reviews, and checks inside the app.";
"help.intelligence.capsule.title" = "Failure Capsules";
"help.intelligence.capsule.1" = "Export current tracked changes, safe untracked files, relevant failure output, and tool versions as a portable .gatto archive.";
"help.intelligence.capsule.2" = "L’export exclut les chemins sensibles connus et masque le texte sensible reconnu, sans garantir la détection de tout secret. Vérifiez avant partage. L’import valide structure et sommes de contrôle des correctifs.";
"help.intelligence.capsule.3" = "Restore creates a new isolated worktree and branch at the recorded base commit. The recorded failing command is never run automatically.";
"help.intelligence.activity.title" = "Agent Activity";
"help.intelligence.activity.1" = "Activity records connect repository state transitions with known coding-agent processes whose working directory was inside that repository.";
"help.intelligence.activity.2" = "GitGatto stores executable names, process IDs, working directories, changed paths, and ref transitions; it does not store process arguments.";
"help.intelligence.activity.3" = "High, possible, ambiguous, and unattributed labels describe evidence strength. They are not proof that a specific Agent caused a change.";
