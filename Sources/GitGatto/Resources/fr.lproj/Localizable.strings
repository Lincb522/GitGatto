/* Task guides */
"help.task.start" = "Utilisation";
"help.task.result" = "Résultat et suite";
"help.task.caution" = "Limites et dépannage";
"help.current_workspace" = "Aide de cet espace de travail";
"help.gettingStarted.tools" = "Les outils du projet ou ⌘K ouvrent recherche, contextes, commandes, exclusions et identités. Chaque outil dispose d’un bouton d’aide ; le menu Aide de cet espace de travail ouvre la section du travail actuel.";
"help.topic.history.title" = "Historique des commits";
"help.topic.history.summary" = "Examiner, comparer et réorganiser les commits.";
"help.history.start" = "Dans l’historique, sélectionnez un commit pour ses fichiers et différences. Comparez deux références. Le menu propose cherry-pick, revert, modification du message, squash, fixup, division, suppression et reset ; les commits locaux peuvent être réordonnés.";
"help.history.result" = "Revert crée un commit d’annulation. Reset soft conserve l’index, mixed conserve les fichiers mais vide l’index, hard abandonne les changements. Une division suspend Git : créez les commits de remplacement, puis continuez.";
"help.history.caution" = "La réécriture peut modifier les identifiants ; les commits publiés sont bloqués par les contrôles. Sauvegardez votre travail et lisez la confirmation. En cas de conflit, résolvez puis continuez ou abandonnez, sans relancer l’action initiale en boucle.";
"help.topic.fileHistory.title" = "Historique des fichiers";
"help.topic.fileHistory.summary" = "Retrouver l’origine d’un fichier ou d’une ligne.";
"help.fileHistory.start" = "Choisissez un fichier puis une révision dans l’historique des fichiers. Examinez contenu, différences et attribution des lignes pour retrouver commit et auteur.";
"help.fileHistory.result" = "Consultez la différence avant de restaurer un fichier. La confirmation remplace le fichier de travail ; si celui-ci a changé depuis l’aperçu, actualisez d’abord l’aperçu.";
"help.fileHistory.caution" = "Si le fichier manque, vérifiez dépôt, chemin et filtres. Pour du travail perdu non committé, cherchez dans les points de restauration ou les stashes ; Git ne l’a pas nécessairement conservé.";
"help.topic.branches.title" = "Branches, tags et remotes";
"help.topic.branches.summary" = "Gérer les références et retrouver un commit.";
"help.branches.start" = "Dans Branches, choisissez branches, tags, remotes ou récupération. Sélectionnez un élément pour changer de branche, renommer, définir l’amont, fusionner, rebaser, créer un tag ou modifier un remote.";
"help.branches.result" = "Fetch actualise les références distantes sans fusionner dans vos fichiers. Pousser un tag et supprimer un tag distant sont des actions distinctes. Depuis le reflog, créez une branche pour examiner le commit choisi.";
"help.branches.caution" = "La suppression sûre vérifie la fusion ; la suppression forcée peut retirer une référence non fusionnée. Le reflog est local et expire : ce n’est pas une sauvegarde. Vérifiez le remote et la cible avant suppression ou réécriture.";
"help.topic.stash.title" = "Stashes";
"help.topic.stash.summary" = "Mettre de côté les changements inachevés.";
"help.stash.start" = "Créez un stash et examinez ses fichiers avant restauration. Incluez les fichiers non suivis si les nouveaux fichiers doivent être conservés ; les fichiers ignorés restent exclus.";
"help.stash.result" = "Appliquer conserve le stash. Appliquer et retirer le supprime après réussite. Supprimer efface l’entrée sans en appliquer le contenu.";
"help.stash.caution" = "La restauration peut créer des conflits. Résolvez-les et vérifiez si le stash existe encore avant de réessayer. Un stash reste dans le dépôt local, n’est pas poussé vers GitHub et n’est pas une sauvegarde indépendante.";
"help.topic.worktrees.title" = "Worktrees";
"help.topic.worktrees.summary" = "Travailler sur une autre branche dans un dossier distinct.";
"help.worktrees.start" = "Dans Worktrees, choisissez branche et destination, créez puis ouvrez depuis la liste. Les fichiers extraits sont séparés, mais les objets Git sont partagés.";
"help.worktrees.result" = "Le panneau permet d’exécuter Agent dans ce dossier et de consulter son résultat. Comparez et vérifiez les changements avant de les intégrer au travail principal.";
"help.worktrees.caution" = "Committez ou sauvegardez avant retrait. Un retrait forcé peut perdre des fichiers ; retirer un worktree ne fusionne pas ses changements. Une branche déjà extraite ailleurs ne peut pas être extraite deux fois.";
"help.topic.recovery.title" = "Centre de récupération";
"help.topic.recovery.summary" = "Créer et gérer des points de restauration locaux.";
"help.recovery.start" = "Ouvrez un dépôt local géré et lancez une sauvegarde dans le centre. Réglez sauvegardes périodiques, changements majeurs, seuils et limites de fichiers dans Réglages → Récupération.";
"help.recovery.result" = "Examinez source, date, taille et compteurs. Restaurer une copie écrit vers une nouvelle destination, sans écraser la source. La gestion permet d’ouvrir les dossiers et de supprimer les sauvegardes d’un dépôt ou toutes les sauvegardes.";
"help.recovery.caution" = "Trois générations maximum par dépôt ; les limites peuvent exclure des fichiers. Changer d’emplacement migre les sauvegardes existantes. Une alerte signale un changement à examiner, pas une attaque prouvée : vérifiez la raison et le point avant restauration.";
"help.topic.monitoring.title" = "Surveillance et barre des menus";
"help.topic.monitoring.summary" = "Voir changements, amont, protection, Actions et objectifs.";
"help.monitoring.start" = "Dans Réglages → Surveillance, activez le moteur puis chaque canal et intervalle séparément. L’affichage dans la barre des menus se règle ici ; masquer l’icône n’arrête pas la surveillance. Chaque dépôt peut utiliser Automatique, Actif ou Basse fréquence. Les limites sur batterie et les contrôles urgents restent actifs.";
"help.monitoring.result" = "Le panneau permet de choisir tous les dépôts ou un seul indépendamment de la fenêtre principale. Il affiche changements, synchronisation, points de restauration et activité quotidienne. L’activité compte commits et signaux de changement, pas des heures de travail.";
"help.monitoring.caution" = "La surveillance après la fermeture nécessite un service activé et autorisé par macOS. Elle est suspendue pendant la veille et après la déconnexion. La protection des Agents et CLI externes observe les dépôts gérés et conserve des points de récupération ; elle ne peut pas intercepter chaque commande destructive ni garantir la récupération des fichiers non enregistrés ou exclus.";
"help.topic.applications.title" = "Dépôt d’applications";
"help.topic.applications.summary" = "Trouver des versions, télécharger et installer.";
"help.applications.start" = "Dans le dépôt d’applications, cherchez ou consultez découverte, favoris, installations et éléments récents. Sélectionnez une app puis un fichier adapté au système et à l’architecture dans Versions et téléchargements.";
"help.applications.result" = "Télécharger ne fait qu’enregistrer le fichier. L’installation rapide poursuit après confirmation ; les paquets nécessitant la ligne de commande passent à Agent. Le gestionnaire affiche progression, journaux et reprise du téléchargement et de l’installation.";
"help.applications.caution" = "La liste installée couvre GitGatto, pas toutes les apps du Mac. Une version peut ne pas avoir de paquet compatible. Après échec, lisez le journal et les prérequis. Un téléchargement terminé ne prouve pas l’installation.";
"help.topic.developerTools.title" = "Outils de développement";
"help.topic.developerTools.summary" = "Détecter, installer, configurer et mettre à jour.";
"help.developerTools.start" = "Actualisez la détection locale dans Outils de développement, puis sélectionnez installation ou mise à jour Agent. Plusieurs outils actualisables peuvent être sélectionnés. Les files montrent les tâches en attente et en cours.";
"help.developerTools.result" = "Jusqu’à trois tâches parallèles ; les verrous d’écriture du gestionnaire peuvent imposer une attente. Ouvrez une tâche pour ses étapes et sorties. Les réglages nécessaires, dont PATH et enregistrement de plugins, précèdent la vérification locale du programme et de sa version. Les ensembles ajoutent les outils choisis à la file. Vérifiez la portée avant l’installation ; le compte rendu distingue la vérification de l’exécutable, les changements de PATH et la configuration par Agent.";
"help.developerTools.caution" = "Le message final d’Agent ne suffit pas. Action requise indique une installation, configuration ou vérification de version inachevée. Utilisez l’autorisation et la reprise proposées. Connexion et autorisation macOS restent personnelles ; être déconnecté seul n’invalide pas une installation vérifiée. Ne supprimez pas les verrous Homebrew actifs.";
"help.topic.collaboration.title" = "Synchronisation et collaboration";
"help.topic.collaboration.summary" = "Gérer plusieurs dépôts, notifications, Issues et PR.";
"help.collaboration.start" = "Dans Projets, ouvrez synchronisation multi-dépôts, boîte de réception ou Issue. Actualisez l’état avant une opération groupée. Filtrez la boîte par catégorie ; consultez, modifiez une Issue ou créez sa branche locale.";
"help.collaboration.result" = "Agent peut rédiger un brouillon de réponse Issue ou PR. Relisez, modifiez, puis envoyez explicitement. Revue PR et Actions se trouvent dans les détails du projet GitHub ; vérifiez contrôles et journaux avant fusion ou relance.";
"help.collaboration.caution" = "Connectez un compte autorisé. Examinez chaque résultat du lot sans relancer aveuglément les réussites. Si un push modifiant un workflow est refusé pour portée OAuth, réautorisez GitHub avec workflow ; un pull n’accorde pas ce droit.";
"help.topic.diagnostics.title" = "Diagnostic de l’environnement";
"help.topic.diagnostics.summary" = "Vérifier outils, Git LFS et hooks.";
"help.diagnostics.start" = "Exécutez les contrôles pour un dépôt local et lisez chaque résultat. Un contrôle réussi ne valide pas tout l’environnement.";
"help.diagnostics.result" = "Si proposé, configurez Git LFS ou réparez le droit d’exécution d’un hook puis recommencez le contrôle. Examinez les scripts inconnus dans le dossier hooks avant exécution.";
"help.diagnostics.caution" = "Installez un programme absent via Outils de développement ; résolvez l’authentification dans le compte concerné. Le diagnostic n’installe pas toutes les dépendances et ne répare pas tout dommage Git. Gardez commande et raison de l’échec pour Agent.";
"help.topic.codeSearch.title" = "Recherche de code";
"help.topic.codeSearch.summary" = "Rechercher dans les dépôts, une révision ou l’historique.";
"help.codeSearch.start" = "Ouvrez la recherche dans les outils du projet ou via ⌘K. Saisissez du texte littéral, choisissez un ou tous les dépôts locaux et la portée travail, révision ou historique. Filtrez si disponible par dossier, langage, extension ou nom.";
"help.codeSearch.result" = "Sélectionnez un résultat pour un aperçu limité, ouvrez le fichier actuel ou transmettez les preuves en brouillon à Agent. Une révision accepte branche, tag ou commit ; l’historique cherche les changements des commits, pas les fichiers actuels.";
"help.codeSearch.caution" = "Pas d’expressions régulières. Résultats et aperçus sont limités, les chemins sensibles connus exclus. Un avertissement de limite ou échec partiel signifie un résultat incomplet : affinez ou réparez le dépôt, puis relancez. Le brouillon ne démarre pas Agent.";
"help.topic.workScenes.title" = "Contextes de travail";
"help.topic.workScenes.summary" = "Sauvegarder changements et contexte avant de changer de tâche.";
"help.workScenes.start" = "Dans les outils du projet, nommez un contexte et enregistrez en vidant les changements. Les modifications indexées, non indexées et non suivies sont mises en stash ; branche, fichier, brouillons, objectif et lien sont enregistrés. Fichiers ignorés exclus.";
"help.workScenes.result" = "La restauration reprend branche et état enregistrés si le travail est propre, sans opération Git en cours et sans déplacement de la branche initiale. Créez sinon un worktree distinct pour laisser le travail actuel intact.";
"help.workScenes.caution" = "Après blocage ou interruption, examinez phase et dépôt. Marquer traité n’est qu’un acquittement, pas une restauration. Supprimer le contexte retire sa fiche et sa référence privée mais conserve le stash d’origine.";
"help.topic.projectCommands.title" = "Exécuter des commandes";
"help.topic.projectCommands.summary" = "Exécuter et contrôler les commandes du projet.";
"help.projectCommands.start" = "Ouvrez Outils du projet → Exécuter des commandes. Vérifiez le programme, le dossier, les arguments et le délai. Saisissez chaque argument séparément ; les espaces y sont conservés.";
"help.projectCommands.result" = "Épinglez des commandes, consultez sortie, durée et code de fin. Arrêtez, relancez, ouvrez les liens localhost ou envoyez un brouillon de journal à Agent. Fermer le panneau laisse tourner ; quitter l’app arrête ses processus.";
"help.projectCommands.caution" = "Exécution non interactive : utilisez un terminal pour les mots de passe. Un délai dépassé n’est pas un succès. Seules les 20 dernières exécutions restent en mémoire dans la session ; sauvegardez les sorties utiles avant de quitter. Relisez les scripts inconnus.";
"help.topic.ignoreRules.title" = "Règles d’exclusion";
"help.topic.ignoreRules.summary" = "Expliquer les exclusions et prévisualiser leurs effets.";
"help.ignoreRules.start" = "Dans les outils du projet, inspectez un chemin pour connaître règle, source et ligne. Choisissez .gitignore pour partager, .git/info/exclude pour une exclusion locale à ce dépôt sur ce Mac.";
"help.ignoreRules.result" = "Modifiez, prévisualisez les fichiers affectés, puis enregistrez. Rechargez après modification externe ou refaites l’aperçu après édition du brouillon. Les règles globales et imbriquées restent applicables.";
"help.ignoreRules.caution" = "Une nouvelle règle ne retire pas un fichier déjà suivi. Arrêter le suivi retire de l’index après confirmation mais garde la copie disque. Vérifiez la suppression indexée avant commit : ce n’est pas supprimer le fichier local.";
"help.topic.identities.title" = "Identités de commit";
"help.topic.identities.summary" = "Choisir l’auteur et vérifier l’identité Git effective.";
"help.identities.start" = "Créez nom, courriel et éventuellement identifiant public de clé de signature dans les outils du projet ; liez le profil à un dépôt ou dossier. Consultez valeurs effectives et sources.";
"help.identities.result" = "Les liens par dossier utilisent Git includeIf. Avant commit, l’auteur réel est comparé au profil, y compris les variables d’environnement. Corrigez la source indiquée plutôt que des réglages globaux sans rapport.";
"help.identities.caution" = "L’identité de commit est distincte du compte GitHub et des permissions distantes. Aucun jeton ni clé privée n’est enregistré ; la signature exige vos outils et clé configurés. Supprimer un profil ne nettoie que ses propres liens, pas le reste de Git.";

