"codex.prompt.explain_changes" = "Expliquez les modifications actuelles de l'arborescence de travail. Résumez l’objectif et l’impact par dossier et identifiez les risques qui nécessitent une attention particulière.";
"codex.prompt.review_staged" = "Passez en revue les modifications par étapes. Donnez la priorité aux découvertes concrètes susceptibles de provoquer des bugs, des pertes de données ou des problèmes de compatibilité.";
"codex.prompt.draft_commit.concise" = "Rédigez un résumé de validation Git précis et spécifique à partir des modifications par étapes en 72 caractères maximum. Renvoie une seule ligne.";
"codex.prompt.draft_commit.complete" = "Rédigez un message de validation Git complet à partir des modifications mises en scène : un résumé de 72 caractères maximum, puis une ligne vierge et 1 à 3 points de corps courts expliquant la motivation et l'impact. Renvoie uniquement le message de validation.";
"codex.prompt.rewrite_commit.concise" = "Réécrivez les modifications par étapes actuelles sous la forme d'un résumé de validation Git plus précis et plus spécifique sur une ligne, ne dépassant pas 72 caractères. Renvoie uniquement le nouveau message.";
"codex.prompt.rewrite_commit.complete" = "Réécrivez les modifications par étapes actuelles sous la forme d'un message de validation complet Git : un résumé de 72 caractères maximum et un corps court expliquant la motivation et l'impact. Renvoie uniquement le nouveau message.";
"codex.prompt.diagnose_repository" = "Inspectez l'état actuel du référentiel pour détecter les problèmes d'arbre de travail, d'index, de branche, de hook, Git LFS, de sous-module ou d'arbre de travail et donnez des étapes de récupération basées sur des preuves. Ne modifiez pas le référentiel.";
"codex.prompt.diagnose_sync" = "Inspectez la branche actuelle, l'amont et l'état avant/derrière et diagnostiquez les pannes probables de traction ou de poussée. N'effectuez pas d'écritures à distance.";
"codex.prompt.diagnose_conflicts" = "Inspectez si le référentiel est dans un conflit de fusion, de rebase, de sélection sélective, de rétablissement ou de stockage et répertoriez les limites du conflit et l'ordre de résolution sécurisé. Ne modifiez pas le référentiel.";
"codex.prompt.trace_history" = "Suivez les modifications récentes, les relations entre les branches et les sources de régression probables à partir de l'historique du référentiel avec des preuves de validation et de fichier vérifiables. Ne modifiez pas le référentiel.";
"codex.prompt.diagnose_github_checks" = "Lisez la demande d'extraction du référentiel actuel et GitHub Les actions vérifient les résultats et identifient l'étape défaillante et sa relation avec les modifications locales. Gardez GitHub en lecture seule.";
