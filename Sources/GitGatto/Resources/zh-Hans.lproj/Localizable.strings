"help.gettingStarted.navigation.3" = "“Agent”绑定当前本地仓库；标题区会显示项目名称与真实暂存数量。";

"help.topic.changes.title" = "变更与暂存";
"help.topic.changes.summary" = "逐文件检查工作区状态和 Diff，明确决定哪些改动进入下一次提交。";
"help.changes.stage.title" = "组织暂存区";
"help.changes.stage.1" = "未暂存与已暂存文件分区显示；选择文件可查看对应的逐行 Diff。";
"help.changes.stage.2" = "使用行尾按钮、右键菜单或“全部暂存/全部取消暂存”移动文件。";
"help.changes.stage.3" = "实时监测会按设置的间隔更新已暂存与未暂存分区，Agent 运行时也不会停止。";
"help.changes.files.title" = "文件操作";
"help.changes.files.1" = "右键可丢弃改动、添加 .gitignore 规则、复制路径或在访达中显示。";
"help.changes.files.2" = "丢弃已跟踪文件会恢复到 HEAD；新文件会移到废纸篓，确认框会说明影响。";
"help.changes.files.3" = "支持使用 Xcode 或系统默认应用打开当前文件，不改变仓库状态。";

"help.topic.sync.title" = "提交与同步";
"help.topic.sync.summary" = "提交只包含暂存区内容；拉取和推送由明确按钮触发，并持续显示运行状态。";
"help.sync.commit.title" = "创建提交";
"help.sync.commit.1" = "可以手动填写，也可以使用“Agent 起草并填入”；没有暂存内容时会先自动暂存当前改动，简洁或完整格式跟随设置。";
"help.sync.commit.2" = "起草完成后可重新编辑、创建本地提交或提交并推送；所有提交和远端写入仍由明确按钮触发。";
"help.sync.commit.3" = "提交完成后会重新读取工作区；如果随后推送失败，本地提交仍会保留。";
"help.sync.remote.title" = "拉取与推送";
"help.sync.remote.1" = "顶部持续显示已同步、待推送、待拉取、分叉或未设置上游；状态刷新、Agent、拉取和推送运行时都有动效。";
"help.sync.remote.2" = "首次推送会在可用远端上为当前分支建立上游，之后按该跟踪关系同步。";
"help.sync.remote.3" = "GitGatto 不执行强制推送、清理、历史重写或自动删除分支。";

"help.topic.github.title" = "GitHub 项目";
"help.topic.github.summary" = "在应用内搜索项目和开发者，阅读完整文档与代码，并处理 Pull Request。";
"help.github.discover.title" = "发现与获取项目";
"help.github.discover.1" = "在“项目”和“用户/开发者”之间切换搜索；用户结果支持模糊排序并显示公开项目。";
"help.github.discover.2" = "“我的项目”包含账号拥有、协作和组织成员可访问的仓库；“每日推荐”从实时 GitHub 数据生成。";
"help.github.discover.3" = "“克隆到本地”保留原仓库；“Fork 并克隆”先在当前账号创建 Fork，再下载到所选目录。";
"help.github.detail.title" = "项目详情";
"help.github.detail.1" = "“概览”使用 GitHub 返回的 Markdown HTML 渲染 README、表格、代码、提示块与图片。";
"help.github.detail.2" = "仓库内文档和代码链接直接在项目详情中导航；外部页面使用应用内浏览器。";
"help.github.detail.3" = "“代码”按默认分支浏览目录和文本文件；二进制文件可转到应用内 GitHub 页面。";
"help.github.detail.4" = "Pull Request 页面可查看说明与 Diff、让 Agent 起草回复，并在确认后发布。";
"help.github.detail.5" = "README 可按四种模板重写；完成后直接显示本地渲染预览。“提交应用”只提交 README，并推送到当前分支。";

"help.topic.agent.title" = "Agent";
"help.topic.agent.summary" = "Agent 使用你配置的本机 CLI 理解当前仓库、处理任务并保留项目级对话记录。";
"help.agent.scope.title" = "项目边界";
"help.agent.scope.1" = "专业 Git 与 GitHub Agent 可分析工作区、暂存区、补丁、历史、分支、冲突、Pull Request 与 GitHub Actions 证据。";
"help.agent.scope.2" = "审阅暂存内容和起草提交信息会先刷新当前项目，再读取真实 git diff --cached。";
"help.agent.scope.3" = "Agent 不负责推送、拉取、修改远端或凭据；这些操作仍由应用中的明确按钮执行。";
"help.agent.workflow.title" = "对话与结果";
"help.agent.workflow.1" = "快捷任务可解释改动、审阅暂存内容或起草提交信息，也可以直接输入具体要求。";
"help.agent.workflow.2" = "回复使用对话式排版；命令、文件改动、运行模式和完成时间保存在对应记录中。";
"help.agent.workflow.3" = "每个本地仓库拥有独立对话历史，重新打开项目后可以继续查看。";
"help.agent.workflow.4" = "可在 Agent 工作区或暂存区下方直接起草；简洁与完整格式可配置，并自动填入提交编辑框。";

"help.topic.translation.title" = "翻译与译文";
"help.topic.translation.summary" = "输入翻译和项目文档翻译使用独立通道，并保留可重复使用的 README 译文。";
"help.translation.document.title" = "文档翻译";
"help.translation.document.1" = "README 只提交可见文本；HTML、代码、链接和资源地址保持原样并按原位置重建。";
"help.translation.document.2" = "译文按仓库、文档路径、目标语言和原文内容保存，原文变化后不会误用旧译文。";
"help.translation.document.3" = "工具栏可随时切换原文、中文和英文；已保存译文无需再次调用 CLI。";
"help.translation.channel.title" = "独立执行通道";
"help.translation.channel.1" = "翻译 CLI 与项目 Agent 分别配置和运行，Agent 处理仓库时仍可翻译。";
"help.translation.channel.2" = "输入框翻译与 README 翻译共用翻译通道，同一时间按顺序处理一个翻译任务。";
"help.translation.channel.3" = "翻译可以停止并设有超时；失败不会删除此前已保存的译文。";

"help.topic.cliSettings.title" = "设置";
"help.topic.cliSettings.summary" = "在同一窗口设置应用界面、启动工作区、Git 实时监测、Agent 与翻译。";
"help.cliSettings.providers.title" = "应用与 Git";
"help.cliSettings.providers.1" = "“外观”可选择明暗模式、完整界面主题，以及预设或自定义强调色；主题会同时改变窗口布局、面板材质和控件样式。";
"help.cliSettings.providers.2" = "“通用”设置界面语言、启动工作区和是否恢复上次打开的本地仓库；“保存并检测”会持久化这些偏好。";
"help.cliSettings.providers.3" = "“Git 与同步”提供手动扫描、本地暂存刷新、只读上游刷新和丢弃确认；不会自动扫描、Pull 或 Push。";
"help.cliSettings.arguments.title" = "Agent 与翻译";
"help.cliSettings.arguments.1" = "“Agent”设置简洁或完整提交起草，并配置项目执行器。";
"help.cliSettings.arguments.2" = "“翻译”拥有独立执行器、进程和参数，Agent 运行时仍可使用。";
"help.cliSettings.arguments.3" = "内置 Codex CLI、Claude Code、Gemini CLI 和 OpenCode；“自定义”可接入任意兼容 CLI，每行一个参数。";
"help.cliSettings.arguments.4" = "GitGatto 复用每个 CLI 自己的本机登录状态，不读取或保存其凭据。";

"help.topic.shortcuts.title" = "快捷键";
"help.topic.shortcuts.summary" = "常用导航和仓库操作可以直接从键盘完成。";
"help.shortcuts.workspace.title" = "切换工作区";
"help.shortcuts.workspace.1" = "⌘1：项目";
"help.shortcuts.workspace.2" = "⌘2：工作区变更";
"help.shortcuts.workspace.3" = "⌘3：提交历史";
"help.shortcuts.workspace.4" = "⌘4：分支；⌘5：Agent";
"help.shortcuts.workspace.5" = "⌘?：打开使用指南";
"help.shortcuts.actions.title" = "常用操作";
"help.shortcuts.actions.1" = "⌘O：打开本地仓库；⌘R：刷新当前仓库。";
"help.shortcuts.actions.2" = "⌘↩：使用当前提交信息提交已暂存内容。";
"help.shortcuts.actions.3" = "在变更文件或最近仓库上点击右键，可打开与当前对象相关的完整菜单。";

"help.topic.troubleshooting.title" = "问题排查";
"help.topic.troubleshooting.summary" = "先确认当前项目、CLI 登录状态和错误提示，再重试失败的单项操作。";
"help.troubleshooting.access.title" = "CLI 与账号";
"help.troubleshooting.access.1" = "GitHub 不可用时，从项目页面发起登录，或先在终端完成 gh auth login。";
"help.troubleshooting.access.2" = "Agent 不可用时，在“设置 > Agent”检查可执行文件、版本参数和该工具自己的本机登录状态。";
"help.troubleshooting.access.3" = "自定义 CLI 若没有版本命令，可以清空“版本检测”；保存后仍会验证可执行文件是否存在。";
"help.troubleshooting.operations.title" = "操作失败";
"help.troubleshooting.operations.1" = "项目缺失时使用“扫描项目”；当前用户不能同时读取、写入和访问目录的仓库不会加入列表。暂存区异常时先确认当前项目并刷新。";
"help.troubleshooting.operations.2" = "推送失败后保留本地提交；处理远端、权限或网络问题后，再点击顶部“推送”。";
"help.troubleshooting.operations.3" = "仓库使用 Git LFS 时需要安装 git-lfs；不再使用时应移除仓库自身的 LFS Hook。";
"help.troubleshooting.operations.4" = "翻译超时或停止后可以重试；原文未变化的已保存译文仍可直接切换。";
"help.troubleshooting.operations.5" = "Git 或 Agent 操作失败时，错误详情会保留完整输出、错误代码和退出代码；点击“复制诊断信息”可用于排查。";

