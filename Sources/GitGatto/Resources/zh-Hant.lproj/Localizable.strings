"help.title" = "GitGatto 幫助";
"help.short_title" = "使用者指南";
"help.menu.guide" = "使用者指南";
"help.topic.gettingStarted.title" = "入門";
"help.topic.gettingStarted.summary" = "從本地儲存庫或GitHub 專案進入工作區。每個變更、提交和遠端操作都使用您實際選擇的項目。";
"help.gettingStarted.open.title" = "打開一個項目";
"help.gettingStarted.open.1" = "按 ⌘O 並選擇現有 Git 儲存庫中的任一資料夾； GitGatto 解析其儲存庫根。";
"help.gettingStarted.open.2" = "專案載入目前GitHub 帳戶可用的儲存庫，並且可以在本地搜尋、分叉或複製它們。";
"help.gettingStarted.open.3" = "僅在請求時才開始掃描。在掃描和新增中，掃描此裝置或選定的資料夾，然後僅選擇要管理的項目。關閉掃描視窗會使任務在背景執行。";
"help.gettingStarted.navigation.title" = "工作區導航";
"help.gettingStarted.navigation.1" = "項目包含GitHub 搜尋、文件、程式碼和拉取請求；更改包含本地修改。";
"help.gettingStarted.navigation.2" = "歷史記錄和分支始終讀取所選的本機儲存庫；使用頂部欄中的目前分支選單可以直接切換本機分支。";
"help.gettingStarted.navigation.3" = "Agent 綁定到目前本機儲存庫，並在標題中顯示其真實項目名稱和暫存計數。";

"help.topic.changes.title" = "變更與分期";
"help.topic.changes.summary" = "檢查工作樹狀態並逐一文件進行比較，然後準確決定下次提交屬於什麼內容。";
"help.changes.stage.title" = "整理臨時區域";
"help.changes.stage.1" = "暫存和未暫存檔案出現在不同的組別中；選擇一個檔案來檢查其逐行差異。";
"help.changes.stage.2" = "使用行操作、上下文選單或全部暫存和全部取消暫存來移動檔案。";
"help.changes.stage.3" = "即時監控依配置的時間間隔更新已暫存和未暫存的群組，包括在 Agent 工作時。";
"help.changes.files.title" = "文件操作";
"help.changes.files.1" = "右鍵點選可放棄變更、新增 .gitignore 規則、複製路徑或在 Finder 中顯示檔案。";
"help.changes.files.2" = "Discard 將追蹤的檔案恢復到 HEAD 並將新檔案移至 Trash；確認解釋了影響。";
"help.changes.files.3" = "在Xcode或其預設應用程式中開啟目前文件，而不更改儲存庫狀態。";

"help.topic.sync.title" = "提交並同步";
"help.topic.sync.summary" = "提交僅包含暫存內容。拉動和推送僅從明確操作運行並在整個操作過程中報告其狀態。";
"help.sync.commit.title" = "建立提交";
"help.sync.commit.1" = "輸入訊息或使用「草稿和填寫」功能Agent。當沒有任何東西上演時，首先上演當前的更改；簡潔或完整的格式遵循設定。";
"help.sync.commit.2" = "起草後，編輯訊息，建立本地提交，或提交並推送。提交和遠端寫入仍然需要明確按鈕。";
"help.sync.commit.3" = "工作區在提交後重新加載。如果後續推送失敗，本地提交保持不變。";
"help.sync.remote.title" = "拉推";
"help.sync.remote.1" = "當狀態、Agent、拉動或推送工作處於活動狀態時，頂部狀態會持續報告同步、超前、落後、發散或缺失上游並以動畫形式顯示。";
"help.sync.remote.2" = "第一次推送在可用遠端上為目前分支建立上游，然後遵循該追蹤關係。";
"help.sync.remote.3" = "分支管理和提交歷史整理是帶確認與檢查的明確操作。發送改動前核對遠程與分支；刷新狀態不會替你執行推送或拉取。";

"help.topic.goals.title" = "計畫目標";
"help.topic.goals.summary" = "將交付結果儲存為可恢復的檢查，該檢查繼續從儲存庫和實際觀察到的GitHub 狀態。";
"help.goals.create.title" = "建立一個目標";
"help.goals.create.1" = "開啟儲存庫後進入「目標」，選擇快捷操作，填寫提交訊息或版本號，點擊「開始執行」。同一儲存庫一次進行一個目標。";
"help.goals.create.2" = "自訂目標先描述結果，由 Agent 唯讀分析並擬定步驟；核對操作範圍後，點擊「開始執行」。";
"help.goals.create.3" = "快速目標涵蓋提交和推送、GitHub 交付和完整發布。 GitHub 傳遞需要預設分支以外的分支。";
"help.goals.create.4" = "目標記錄其儲存庫、分支、基線提交、步驟和證據。切換存儲庫不會混合它們的狀態。 也可從目前變更、Issue、PR 或失敗檢查建立目標，並選擇已儲存的專案命令，在提交前執行驗證。";
"help.goals.execute.title" = "運行並恢復";
"help.goals.execute.1" = "開始後會連續執行已授權的步驟，每一步都重新讀取 Git 與 GitHub 狀態。合併、發佈和安裝會停下等待確認。";
"help.goals.execute.2" = "失敗的步驟保留其原始證據並停止在「需要注意」處。完成的步驟在應用程式重新啟動後仍然有效。";
"help.goals.execute.3" = "Actions 失敗時點擊「修復並繼續」。修復成功且儲存庫、分支未變時自動繼續；取消、失敗或保護檢查要求複核時會停下。";
"help.goals.execute.4" = "如果簽出分支與其目標分支不同，目標就會停止。切換回來，然後刷新或繼續。";
"help.goals.release.title" = "合併與發布";
"help.goals.release.1" = "完整的發布會在提交和推送之前檢查README 和翻譯、版本和建置、變更日誌和發布工作流程。";
"help.goals.release.2" = "在發布標籤之後，它會驗證GitHub發布、DMG和更新來源。安裝驗證讀取實際安裝的應用程式版本。";
"help.goals.release.3" = "合併拉取請求、發布版本和安裝應用程式均需單獨確認。";

"help.topic.regression.title" = "回歸調查";
"help.topic.regression.summary" = "縮小隔離工作樹中的提交範圍，找到第一個錯誤提交，並將修復、驗證和 PR 證據保留在一起。";
"help.regression.start.title" = "開始調查";
"help.regression.start.1" = "已知的善必定是已知的惡的祖先。任一邊界接受提交、標籤或分支；壞邊界通常是 HEAD。";
"help.regression.start.2" = "自動模式需要可重複的指令。手動模式適合需要 UI、設備或人工觀察的故障。";
"help.regression.start.3" = "GitGatto 使用隔離的 Git 工作樹並一分為二，無需切換目前儲存庫中的分支或 HEAD。";
"help.regression.start.4" = "應用程式重新開啟後，可以暫停調查並從相同工作樹和候選提交中恢復。";
"help.regression.verdict.title" = "自動和手動判決";
"help.regression.verdict.1" = "在自動模式下，退出代碼 0 是好的，1-124 是壞的，125 跳過目前提交。";
"help.regression.verdict.2" = "退出代碼 126、127 或 128 以上會停止使用原始輸出進行調查，而不是對提交進行錯誤分類。";
"help.regression.verdict.3" = "手動模式一次顯示一個候選者。選擇「好」、「壞」或「跳過」以推進同一平分會話。";
"help.regression.fix.title" = "修復與證據";
"help.regression.fix.1" = "結果保留第一個錯誤提交、其摘要、平分日誌以及每個探測的持續時間、退出代碼和輸出。";
"help.regression.fix.2" = "使用Agent 修復僅適用於隔離分支。您也可以顯示該工作樹並自行編輯。";
"help.regression.fix.3" = "自動模式重新運行原始命令；手動模式需要明確的通過或失敗。在修復通過之前無法建立 PR。";
"help.regression.fix.4" = "提交並建立 PR 提交隔離分支、推送來源並建立GitHub PR。刪除工作樹會保留其證據。";

"help.topic.github.title" = "GitHub項目";
"help.topic.github.summary" = "搜尋專案和開發人員，閱讀應用程式中的完整文件和程式碼，並處理拉取請求。";
"help.github.discover.title" = "發現並取得項目";
"help.github.discover.1" = "在專案和人員搜尋之間切換。用戶結果使用模糊排名並包括公共儲存庫。";
"help.github.discover.2" = "我的專案包括自有、協作和組織儲存庫；每日精選來自目前的GitHub資料。";
"help.github.discover.3" = "克隆本地保留來源儲存庫。 Fork & Clone 首先在目前帳戶中建立一個分叉，然後下載它。";
"help.github.detail.title" = "專案詳情";
"help.github.detail.1" = "概述呈現來自 GitHub Markdown HTML 的 README，包括表格、程式碼、警報和圖片。";
"help.github.detail.2" = "儲存庫文件和程式碼連結在專案詳細資料中導航；外部頁面使用應用程式內瀏覽器。";
"help.github.detail.3" = "程式碼按資料夾瀏覽預設分支並顯示文字檔案；二進位檔案可以在應用程式內的GitHub上開啟。";
"help.github.detail.4" = "Pull Requests 顯示描述和差異，請Agent 起草回复，並僅在確認後發布。";
"help.github.detail.5" = "使用四個模板之一重寫README，並立即查看渲染的本地結果。提交並應用僅提交README並推送目前分支。";

"help.topic.agent.title" = "Agent";
"help.topic.agent.summary" = "Agent 使用您配置的本地CLI 來了解目前儲存庫、執行任務並保留專案級對話。";
"help.agent.scope.title" = "儲存庫邊界";
"help.agent.scope.1" = "專業人員Git和GitHubAgent可以檢查工作樹、暫存、補丁、歷史記錄、分支、衝突、拉取請求和GitHub操作證據。";
"help.agent.scope.2" = "分階段評審和提交草稿首先刷新所選項目，然後讀取真正的 git diff --cached。";
"help.agent.scope.3" = "Agent 不會推送、拉取、更改遙控器或管理憑證；明確應用程式控制項擁有這些操作。";
"help.agent.workflow.title" = "對話與結果";
"help.agent.workflow.1" = "快速任務可以解釋變更、審查暫存或起草提交訊息，並且您可以直接輸入特定請求。";
"help.agent.workflow.2" = "回覆使用會話格式；指令、檔案變更、模式和完成時間保留在每個結果中。";
"help.agent.workflow.3" = "每個本機儲存庫都有單獨的對話記錄，該歷史記錄會在專案重新開啟時傳回。";
"help.agent.workflow.4" = "來自Agent工作區或舞台正下方的草稿；簡潔完整的格式可配置，自動填寫作曲家。";

"help.topic.translation.title" = "翻譯";
"help.topic.translation.summary" = "提示和專案文件翻譯獨立於Agent運行，並保留可重複使用的README翻譯。";
"help.translation.document.title" = "文件翻譯";
"help.translation.document.1" = "README 翻譯僅發送可見文字； HTML、程式碼、連結和資產地址保持不變並恢復原位。";
"help.translation.document.2" = "翻譯由儲存庫、路徑、目標語言和來源內容鍵入，因此更改的文件永遠不會重複使用過時的文字。";
"help.translation.document.3" = "翻譯菜單可切換原文與支持的目標語言，不只限於英文和中文。源文未變時可復用已緩存的譯文；翻譯展示不會替你提交改寫後的 README。";
"help.translation.channel.title" = "獨立執行通道";
"help.translation.channel.1" = "翻譯 CLI 和專案 Agent 具有單獨的配置和流程，因此在 Agent 工作時翻譯仍然可用。";
"help.translation.channel.2" = "自動翻譯會檢測可讀文本並使用設定的目標語言。已經是該語言、或短到不足以判斷的內容可能保持原樣。沒有反應時，先檢查設置中的翻譯引擎與目標語言。";
"help.translation.channel.3" = "翻譯可以停止，有超時；失敗不會刪除已儲存的翻譯。 重試沿用上次失敗時選擇的語言。翻譯失敗時仍可查看原文。";

"help.topic.cliSettings.title" = "設置";
"help.topic.cliSettings.summary" = "從一個視窗配置應用程式介面、啟動工作區、即時Git監控、Agent和翻譯。";
"help.cliSettings.providers.title" = "應用程式和Git";
"help.cliSettings.providers.1" = "外觀控制明暗模式、完整的介面主題以及預設或自訂重音。主題會同時變更視窗佈局、面板材質和控制項樣式。 曜幕還可分別調整淺色與深色外觀的背景、面板、文字、按鈕及狀態顏色；選擇方案並預覽後，按「套用配色」儲存，或恢復預設。";
"help.cliSettings.providers.2" = "通用設置可調整啓動、關閉窗口行為與界面語言；語言切換即時生效。其他編輯後的設置使用“保存並檢測”。外觀、監控和災備分別有對應設置分區。";
"help.cliSettings.providers.3" = "Git & 同步連結到手動掃描、本地暫存刷新、只讀上游刷新和丟棄確認；它從不自動掃描、拉動或推送。";
"help.cliSettings.arguments.title" = "Agent 和翻譯";
"help.cliSettings.arguments.1" = "Agent 選擇簡潔或完整的提交起草並配置其專案執行器。";
"help.cliSettings.arguments.2" = "翻譯具有單獨的執行程序、進程和參數，因此在Agent 工作時它仍然可用。";
"help.cliSettings.arguments.3" = "預設涵蓋Codex CLI、Claude Code、Gemini CLI 和 OpenCode; Custom 接受任何相容的CLI，每行一個參數。";
"help.cliSettings.arguments.4" = "GitGatto 重複使用每個 CLI 自己的本地登錄，並且從不讀取或儲存其憑證。";

"help.topic.shortcuts.title" = "鍵盤快速鍵";
"help.topic.shortcuts.summary" = "直接從鍵盤導航應用程式並執行常見的儲存庫操作。";
"help.shortcuts.workspace.title" = "切換工作空間";
"help.shortcuts.workspace.1" = "⌘1：項目";
"help.shortcuts.workspace.2" = "⌘2：更改";
"help.shortcuts.workspace.3" = "⌘3：歷史";
"help.shortcuts.workspace.4" = "⌘4：分支； ⌘5: Agent";
"help.shortcuts.workspace.5" = "⌘?：打開GitGatto幫助";
"help.shortcuts.actions.title" = "常用操作";
"help.shortcuts.actions.1" = "⌘O：開啟本地倉庫； ⌘R：重新整理目前儲存庫。";
"help.shortcuts.actions.2" = "⌘↩：使用目前提交訊息提交暫存內容。";
"help.shortcuts.actions.3" = "⌘K 打開命令面板；右鍵改動文件或最近倉庫可查看對應操作。“幫助 → 當前工作區說明”會打開當前功能的指南。 常用命令可以固定，最近使用的入口會排在前面。方向鍵選取，Return 執行。";

"help.topic.troubleshooting.title" = "故障排除";
"help.topic.troubleshooting.summary" = "確認所選項目、本地CLI登入並報告錯誤，然後重試失敗的操作。";
"help.troubleshooting.access.title" = "CLI 和帳戶訪問";
"help.troubleshooting.access.1" = "如果GitHub不可用，請從專案開始登入或在終端機中完成 gh 驗證登入。";
"help.troubleshooting.access.2" = "如果 Agent 不可用，請在「設定」> Agent 下檢查其可執行檔案、版本參數以及 CLI 自己的本機登入。";
"help.troubleshooting.access.3" = "若自訂CLI沒有版本指令，清除版本檢查； 「儲存並檢查」仍會驗證可執行檔是否存在。";
"help.troubleshooting.operations.title" = "操作失敗";
"help.troubleshooting.operations.1" = "如果項目遺失，請使用掃描項目；不會新增目前使用者無法讀取、寫入和遍歷的儲存庫。對於過時的暫存，請確認所選項目並重新整理。";
"help.troubleshooting.operations.2" = "失敗的推送會保留其本地提交。解決遠端、權限或網路問題，然後再次使用推播。";
"help.troubleshooting.operations.3" = "使用Git LFS的儲存庫需要 git-lfs；如果不再使用 LFS，請刪除儲存庫的 LFS 掛鉤。";
"help.troubleshooting.operations.4" = "重試超時或停止的翻譯；保存的翻譯仍可選擇，而來源不變。";
"help.troubleshooting.operations.5" = "Git 和Agent 失敗保留完整的輸出、錯誤代碼和退出代碼；當您需要調查時，請使用複製診斷。";

"appearance.system" = "關注系統";
"appearance.light" = "光";
"appearance.dark" = "深色";

