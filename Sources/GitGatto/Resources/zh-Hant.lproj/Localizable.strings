/* Task guides */
"help.task.start" = "怎麼使用";
"help.task.result" = "結果與後續操作";
"help.task.caution" = "限制與問題處理";
"help.current_workspace" = "當前工作區說明";
"help.gettingStarted.tools" = "頂部“項目工具”或 ⌘K 可找到代碼搜索、工作現場、運行命令、忽略規則和提交身份。各工具右上角有指南按鈕；菜單“幫助 → 當前工作區說明”可直接打開當前工作區對應章節。";
"help.topic.history.title" = "提交歷史";
"help.topic.history.summary" = "查看、比較和整理提交。";
"help.history.start" = "進入“提交歷史”，選擇提交後查看文件和差異。“比較”可選擇兩個引用。提交菜單提供揀選、還原、修改說明、合併、修正、拆分、丟棄和重置；“調整本機提交順序”可調整回放順序。";
"help.history.result" = "還原會新建一個撤銷改動的提交。軟重置保留暫存，中度重置保留文件但清空暫存，硬重置丟棄改動。拆分會暫停 Git 操作：創建替代提交後，再繼續。";
"help.history.caution" = "整理歷史可能改變提交哈希；重寫檢查會阻止已發佈提交。先保存當前改動，讀完確認信息再執行。遇到衝突，先解決再繼續或中止，不要反復點擊原來的操作。";
"help.topic.fileHistory.title" = "文件歷史";
"help.topic.fileHistory.summary" = "查找文件和某一行的改動來源。";
"help.fileHistory.start" = "進入“文件歷史”，先選文件，再選版本，查看內容和差異。行級歸屬可定位某一行對應的提交和作者。";
"help.fileHistory.result" = "還原檔案前先預覽與目前內容的差異。確認後才替換工作檔案；預覽後檔案又被修改時，需要重新整理預覽。";
"help.fileHistory.caution" = "找不到文件時，先核對倉庫、路徑和篩選條件。丟失的是未提交內容時，請查看災備恢復點或貯藏，不要把提交歷史當成完整的文件備份。";
"help.topic.branches.title" = "分支、標籤與遠程";
"help.topic.branches.summary" = "管理引用，並從本地記錄找回提交。";
"help.branches.start" = "進入“分支”，切換分支、標籤、遠程或恢復記錄。選中項目後，可切換分支、重命名、設置上游、合併、變基、新建標籤或編輯遠程。";
"help.branches.result" = "獲取遠程只更新遠程跟蹤引用，不會把改動合併進當前文件。推送標籤和刪除遠程標籤是單獨操作。“復原”可從 reflog 選擇提交，新建分支後檢查內容。";
"help.branches.caution" = "安全刪除會檢查分支合併狀態，強制刪除可能移除尚未合併的引用。reflog 只在本機保存且會過期，不能代替備份。刪除和重寫前先核對遠程與目標。";
"help.topic.stash.title" = "貯藏";
"help.topic.stash.summary" = "暫存未完成的工作，稍後再恢復。";
"help.stash.start" = "進入“貯藏”創建一份貯藏，恢復前先查看文件。新文件也要保存時，勾選包含未跟蹤文件；這個選項不包含被忽略的文件。";
"help.stash.result" = "“應用”恢復改動並保留貯藏；“應用並移除”成功後會移除貯藏；“刪除貯藏”直接刪除保存記錄，不會把內容應用回來。";
"help.stash.caution" = "恢復可能與當前文件衝突。先解決衝突，並檢查貯藏是否仍在，再決定下一步。貯藏屬於本地倉庫，不會隨推送上傳到 GitHub，也不等於獨立的災備副本。";
"help.topic.worktrees.title" = "工作樹";
"help.topic.worktrees.summary" = "在獨立目錄中處理另一個分支。";
"help.worktrees.start" = "進入“工作樹”，選擇分支和目標目錄創建工作樹，再從列表打開。各工作樹有獨立的檢出文件，但共用倉庫的 Git 對象。";
"help.worktrees.result" = "可在工作樹面板中讓 Agent 處理該目錄並查看結果。先比較、檢查改動，再決定如何帶回主要工作分支。";
"help.worktrees.caution" = "移除前先提交或保存改動，強制移除可能丟失文件。刪除工作樹不代表合併了它的改動；已經在其他工作樹檢出的分支不能重復檢出。";
"help.topic.recovery.title" = "災備中心";
"help.topic.recovery.summary" = "創建、檢查、恢復和管理本地恢復點。";
"help.recovery.start" = "打開已管理的本地倉庫，進入“災備中心”點擊“立即備份”。自動備份在“設置 → 災備”中配置，可調整定時、重大改動閾值和文件限制。";
"help.recovery.result" = "選中恢復點查看源倉庫、時間、大小與改動數量。“恢復副本”寫入新目錄，不覆蓋源倉庫。“管理備份”可打開目錄，刪除某個倉庫的備份或全部備份。";
"help.recovery.caution" = "每個倉庫最多輪換保留三份，文件限制可能造成遺漏。在設置中更換備份位置會遷移現有備份。倉庫守衛提醒表示檢測到了需要檢查的變化，不等於確認遭到攻擊；恢復前先核對原因和恢復點。";
"help.topic.monitoring.title" = "監控與狀態欄";
"help.topic.monitoring.summary" = "查看改動、上游狀態、倉庫保護、Actions 和目標。";
"help.monitoring.start" = "在“設置 → 監控”開啓引擎，分別選擇監控通道和刷新間隔。狀態欄顯示開關也在這裡；隱藏圖標不等於停止監控。 每個儲存庫可個別選擇自動、活躍或低頻。電池限制和危險變更檢查仍然生效。";
"help.monitoring.result" = "點擊狀態欄圖標，可獨立選擇“所有倉庫”或單個倉庫，不受主窗口當前選擇限制。面板顯示實際改動、同步狀態、恢復點和每日活動；活動統計包含提交與改動信號，不是編碼時長。";
"help.monitoring.caution" = "只有開啟「退出後繼續監控」並獲系統允許，主程式退出後才會繼續監控。睡眠或登出期間不監控。外部 Agent 與 CLI 保護會觀察已管理倉庫並保留復原基準，但無法攔截每條破壞性命令，也無法保證找回未儲存或已排除的檔案。";
"help.topic.applications.title" = "應用倉庫";
"help.topic.applications.summary" = "查找發行版、下載安裝包和安裝應用。";
"help.applications.start" = "進入“應用倉庫 → 應用”，搜索或瀏覽發現、收藏、已安裝、最近項目。選中應用後查看“版本與下載”，選擇符合系統和芯片架構的安裝包。";
"help.applications.result" = "下載只保存文件；“快捷安裝”在確認後繼續安裝。需要命令行處理的安裝包會交給 Agent。“下載管理”顯示下載與安裝進度、日誌和重試入口。";
"help.applications.caution" = "“已安裝”記錄通過 GitGatto 安裝的應用，不是掃描出本機所有應用。發行版可能沒有適合當前系統的包。失敗時先看日誌與前置條件，再重試；下載完成不代表安裝成功。";
"help.topic.developerTools.title" = "開發工具";
"help.topic.developerTools.summary" = "安裝、配置、檢測和升級本機工具。";
"help.developerTools.start" = "進入“應用倉庫 → 開發工具”，刷新本機檢測，選擇工具執行 Agent 安裝或升級。可多選可升級工具批量處理，安裝隊列與升級隊列會顯示等待和運行中的任務。";
"help.developerTools.result" = "最多三路任務並行，包管理器的寫入鎖仍可能讓某一步等待。打開任務可查看階段和輸出。安裝包含必要的用戶配置，如 PATH、插件註冊，之後還會檢查本機可執行文件和版本。 工具組合會將選取的工具加入佇列。安裝前可展開影響範圍；設定回執分別顯示執行檔驗證、PATH 修改和 Agent 設定結果。";
"help.developerTools.caution" = "Agent 說完成不代表驗證成功。“需要完成操作”表示安裝、配置或版本檢查仍未完成。權限問題出現“授權並重試”時按提示操作。賬號登錄與 macOS 授權仍需本人完成；僅未登錄不會讓已驗證的安裝失敗。其他任務運行時不要手動刪除 Homebrew 鎖。";
"help.topic.collaboration.title" = "同步、收件箱與協作";
"help.topic.collaboration.summary" = "處理多倉庫同步、Issue、PR 和 Actions。";
"help.collaboration.start" = "在“項目”中切換“多倉庫同步”“收件箱”或“Issue”。批量同步前先刷新各倉庫狀態。收件箱可按類別篩選，Issue 可查看討論、編輯或創建本地分支。";
"help.collaboration.result" = "Issue 和 PR 回復框可讓 Agent 起草，檢查並修改草稿後再主動發送。PR 審閱和 Actions 位於 GitHub 項目詳情頁；合併或重試工作流前先查看檢查結果和日誌。";
"help.collaboration.caution" = "先登錄有倉庫訪問權限的賬號。批量結果按倉庫分別顯示，不要盲目重跑已成功項。修改工作流文件的推送若因 OAuth 權限被拒絕，需要重新授權 GitHub 的 workflow 權限，拉取代碼不能補授權。";
"help.topic.diagnostics.title" = "環境診斷";
"help.topic.diagnostics.summary" = "檢查倉庫工具、Git LFS 和 hooks。";
"help.diagnostics.start" = "打開本地倉庫，進入“環境診斷”運行檢查。逐項查看結果，不要把某一項通過當成所有環境都正常。";
"help.diagnostics.result" = "有對應入口時，可配置 Git LFS 或修復 hook 的執行權限，然後重新檢測。運行不熟悉的腳本前，先打開 hooks 目錄檢查內容。";
"help.diagnostics.caution" = "缺少可執行文件可去“開發工具”安裝；登錄失敗要處理對應賬號。診斷不會自動安裝所有依賴，也不能自動修復任意倉庫損壞。交給 Agent 排查時保留失敗命令和原因。";
"help.topic.codeSearch.title" = "代碼搜索";
"help.topic.codeSearch.summary" = "搜索已管理倉庫、指定版本或提交歷史。";
"help.codeSearch.start" = "從“項目工具 → 代碼搜索”進入，也可按 ⌘K 查找入口。輸入普通文本，選擇一個或全部本地倉庫，以及工作區、指定版本或歷史範圍；按需篩選目錄、語言、擴展名或文件名。";
"help.codeSearch.result" = "選擇結果查看限量預覽，可打開當前文件或把證據交給 Agent 形成草稿。指定版本支持分支、標籤或提交；歷史搜索查找的是提交改動，不是當前檢出的文件。";
"help.codeSearch.caution" = "搜索不是正則匹配，結果與預覽有數量限制，已知敏感路徑會被排除。出現上限提示或部分倉庫失敗時，結果並不完整；縮小條件或處理對應倉庫後重試。發送草稿不會自動啓動 Agent。";
"help.topic.workScenes.title" = "工作現場";
"help.topic.workScenes.summary" = "切換任務前保存改動和工作上下文。";
"help.workScenes.start" = "進入“項目工具 → 工作現場”，填寫名稱後“保存並清空當前改動”。它會貯藏已暫存、未暫存與未跟蹤文件，並記錄分支、所選文件、草稿、目標和關聯鏈接；不保存被忽略文件。";
"help.workScenes.result" = "恢復會切回記錄的分支並還原保存狀態，要求工作區乾淨、沒有未結束的 Git 操作，且原分支未移動。想保留當前檢出不動，可從場景創建獨立工作樹。";
"help.workScenes.caution" = "恢復受阻或中斷時，先檢查階段與倉庫，再決定是否重試。標記已處理只是確認處理過，不會恢復文件。刪除場景只清理其記錄與專用引用，原始貯藏仍可在“貯藏”頁找到。";
"help.topic.projectCommands.title" = "運行命令";
"help.topic.projectCommands.summary" = "運行項目命令並檢查輸出和結果。";
"help.projectCommands.start" = "進入「專案工具 → 執行命令」。執行前檢查執行檔、目錄、參數與逾時。自訂參數逐項填寫，空格保留在對應參數內。";
"help.projectCommands.result" = "可固定常用命令，查看實時輸出、耗時和退出狀態，停止或重試任務，打開輸出中的 localhost 鏈接，或把日誌交給 Agent 形成草稿。關閉面板不會停任務；退出應用會停止它啓動的進程。";
"help.projectCommands.caution" = "命令以非交互方式執行，密碼輸入或交互安裝請使用終端。超時不算成功；當前會話只在內存保留最近 20 條運行記錄，需要的日誌請在退出前保存。未知項目腳本先檢查再運行。";
"help.topic.ignoreRules.title" = "忽略規則";
"help.topic.ignoreRules.summary" = "解釋文件為何被忽略，預覽規則的影響。";
"help.ignoreRules.start" = "進入“項目工具 → 忽略規則”，輸入路徑檢查命中的規則、來源文件和行號。共享規則選倉庫 .gitignore，僅本機使用的規則選 .git/info/exclude。";
"help.ignoreRules.result" = "編輯後先預覽受影響文件，再保存。外部已修改規則或預覽後又改過草稿時，需要重新加載或重新預覽。子目錄規則與全局規則仍會影響最終結果。";
"help.ignoreRules.caution" = "添加忽略規則不會讓已提交文件自動停止跟蹤。“停止跟蹤，保留本地文件”確認後只移除索引記錄，保留磁盤文件；提交前檢查這份已暫存的刪除。它不是刪除本機文件。";
"help.topic.identities.title" = "提交身份";
"help.topic.identities.summary" = "選擇提交作者，並核對 Git 實際使用的身份。";
"help.identities.start" = "進入“項目工具 → 提交身份”，建立姓名、郵箱及可選的簽名公鑰標識配置，再綁定到倉庫或目錄。面板可查看實際生效值和配置來源。";
"help.identities.result" = "目錄綁定使用 Git includeIf 規則。提交前會對照所選身份檢查實際作者，包括環境變量的覆蓋。發現不一致時按來源修正，不要直接改動無關的全局設置。";
"help.identities.caution" = "提交身份與 GitHub 登錄、遠程訪問權限無關。身份配置不保存私鑰或令牌，簽名仍依賴已經配置好的密鑰和工具。刪除身份只清理它自己管理的綁定，不改無關的 Git 配置。";

