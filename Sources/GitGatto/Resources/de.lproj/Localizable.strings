"help.topic.gettingStarted.summary" = "Rufen Sie den Arbeitsbereich aus einem lokalen Repository oder einem GitHub-Projekt auf. Bei jeder Änderung, jedem Commit und jeder Remote-Aktion wird das Projekt verwendet, das Sie tatsächlich ausgewählt haben.";
"help.gettingStarted.open.title" = "Öffnen Sie ein Projekt";
"help.gettingStarted.open.1" = "Drücken Sie ⌘O und wählen Sie einen beliebigen Ordner in einem vorhandenen Git-Repository; GitGatto löst sein Repository-Stammverzeichnis auf.";
"help.gettingStarted.open.2" = "Projects lädt Repositorys, die für das aktuelle GitHub-Konto verfügbar sind, und kann sie lokal durchsuchen, forken oder klonen.";
"help.gettingStarted.open.3" = "Der Scanvorgang startet nur auf Anfrage. Scannen Sie unter „Scannen und Hinzufügen“ dieses Gerät oder ausgewählte Ordner und wählen Sie dann nur die zu verwaltenden Projekte aus. Durch das Schließen des Scanfensters wird die Aufgabe im Hintergrund ausgeführt.";
"help.gettingStarted.navigation.title" = "Arbeitsbereichsnavigation";
"help.gettingStarted.navigation.1" = "Projekte enthält GitHub Suche, Dokumentation, Code und Pull-Anfragen; Änderungen enthalten lokale Änderungen.";
"help.gettingStarted.navigation.2" = "Verlauf und Zweige lesen immer das ausgewählte lokale Repository; Verwenden Sie das Menü „Aktueller Zweig“ in der oberen Leiste, um direkt zwischen lokalen Zweigen zu wechseln.";
"help.gettingStarted.navigation.3" = "Agent bindet an das aktuelle lokale Repository und zeigt seinen tatsächlichen Projektnamen und die Anzahl der bereitgestellten Dateien im Header an.";

"help.topic.changes.title" = "Änderungen und Staging";
"help.topic.changes.summary" = "Überprüfen Sie den Arbeitsbaumstatus und die Unterschiede Datei für Datei und entscheiden Sie dann genau, was in den nächsten Commit gehört.";
"help.changes.stage.title" = "Organisieren Sie den Bereitstellungsbereich";
"help.changes.stage.1" = "Gespeicherte und nicht bereitgestellte Dateien werden in separaten Gruppen angezeigt. Wählen Sie eine Datei aus, um deren zeilenweisen Unterschied zu überprüfen.";
"help.changes.stage.2" = "Verschieben Sie Dateien mit der Zeilenaktion, dem Kontextmenü oder „Alle bereitstellen“ und „Alle bereitstellen“ aufheben.";
"help.changes.stage.3" = "Live-Überwachung aktualisiert bereitgestellte und nicht bereitgestellte Gruppen im konfigurierten Intervall, auch während Agent arbeitet.";
"help.changes.files.title" = "Dateiaktionen";
"help.changes.files.1" = "Klicken Sie mit der rechten Maustaste, um Änderungen zu verwerfen, .gitignore-Regeln hinzuzufügen, Pfade zu kopieren oder eine Datei im Finder anzuzeigen.";
"help.changes.files.2" = "„Verwerfen“ stellt verfolgte Dateien in HEAD wieder her und verschiebt neue Dateien in den Papierkorb. Die Bestätigung erläutert die Auswirkungen.";
"help.changes.files.3" = "Öffnen Sie die aktuelle Datei in Xcode oder seiner Standardanwendung, ohne den Repository-Status zu ändern.";

"help.topic.sync.title" = "Festschreiben und synchronisieren";
"help.topic.sync.summary" = "Commits enthalten nur bereitgestellte Inhalte. Pull und Push führen nur explizite Aktionen aus und melden ihren Status während des gesamten Vorgangs.";
"help.sync.commit.title" = "Erstellen Sie ein Commit";
"help.sync.commit.1" = "Geben Sie eine Nachricht ein oder verwenden Sie Draft & Fill mit Agent. Wenn nichts bereitgestellt wird, werden zuerst die aktuellen Änderungen bereitgestellt. Das prägnante oder vollständige Format folgt den Einstellungen.";
"help.sync.commit.2" = "Bearbeiten Sie nach dem Verfassen der Nachricht die Nachricht, erstellen Sie einen lokalen Commit oder Commit und Push. Für Commits und Remote-Schreibvorgänge ist weiterhin eine explizite Schaltfläche erforderlich.";
"help.sync.commit.3" = "Der Arbeitsbereich wird nach einem Commit neu geladen. Wenn der folgende Push fehlschlägt, bleibt der lokale Commit erhalten.";
"help.sync.remote.title" = "Ziehen und drücken";
"help.sync.remote.1" = "Der Top-Status meldet kontinuierlich synchronisiert, voraus, hinterher, divergiert oder fehlender Upstream und wird animiert, während der Status Agent, Pull- oder Push-Arbeit aktiv ist.";
"help.sync.remote.2" = "Der erste Push richtet einen Upstream für den aktuellen Zweig auf einer verfügbaren Fernbedienung ein und folgt dann dieser Tracking-Beziehung.";
"help.sync.remote.3" = "GitGatto erzwingt kein automatisches Pushen, Bereinigen, Umschreiben des Verlaufs oder Löschen von Zweigen.";

"help.topic.goals.title" = "Projektziele";
"help.topic.goals.summary" = "Speichern Sie ein Lieferergebnis als wiederherstellbare Prüfungen, die vom Repository und dem tatsächlich beobachteten GitHub-Status fortgesetzt werden.";
"help.goals.create.title" = "Erstellen Sie ein Ziel";
"help.goals.create.1" = "Öffnen Sie ein lokales Repository und geben Sie dann Ziele ein. Ein Repository kann jeweils nur ein unvollendetes Ziel haben.";
"help.goals.create.2" = "Ein benutzerdefiniertes Ziel fordert Agent auf, das Ergebnis in unterstützte Bedingungen umzuwandeln. Die Planung ist schreibgeschützt; Das Ziel wird erst erstellt, nachdem Sie den Kandidaten bestätigt haben.";
"help.goals.create.3" = "Schnelle Ziele umfassen Commit und Push, GitHub Lieferung und vollständige Veröffentlichung. Für die GitHub-Auslieferung ist ein anderer Zweig als der Standardzweig erforderlich.";
"help.goals.create.4" = "Das Ziel zeichnet sein Repository, seinen Zweig, seinen Baseline-Commit, seine Schritte und Beweise auf. Durch das Wechseln von Repositorys wird deren Status nicht verwechselt.";
"help.goals.execute.title" = "Ausführen und wiederherstellen";
"help.goals.execute.1" = "„Weiter“ führt nur den aktuell umsetzbaren Schritt aus und lädt dann nach jedem Schritt den Status Git und GitHub neu.";
"help.goals.execute.2" = "Ein fehlgeschlagener Schritt behält seinen ursprünglichen Beweis und stoppt bei „Benötigt Aufmerksamkeit“. Abgeschlossene Schritte überleben einen App-Neustart.";
"help.goals.execute.3" = "Wenn Aktionen fehlschlagen, ist die Agent-Reparatur ab diesem Schritt verfügbar. Das Fernergebnis muss nach der Reparatur noch überprüft werden.";
"help.goals.execute.4" = "Ein Ziel stoppt, wenn der ausgecheckte Zweig von seinem Zielzweig abweicht. Zurückschalten, dann aktualisieren oder fortfahren.";
"help.goals.release.title" = "Zusammenführen und freigeben";
"help.goals.release.1" = "Bei einem vollständigen Release werden README und Übersetzung, Version und Build, Änderungsprotokoll und Release-Workflow vor dem Festschreiben und Pushen überprüft.";
"help.goals.release.2" = "Nach dem Release-Tag werden die Version GitHub, DMG und der Update-Feed überprüft. Bei der Installationsüberprüfung wird die tatsächlich installierte App-Version gelesen.";
"help.goals.release.3" = "Das Zusammenführen einer Pull-Anfrage, das Veröffentlichen eines Releases und die Installation der App erfordern jeweils eine separate Bestätigung.";

"help.topic.regression.title" = "Regressionsuntersuchung";
"help.topic.regression.summary" = "Grenzen Sie einen Commit-Bereich in einem isolierten Arbeitsbaum ein, lokalisieren Sie den ersten fehlerhaften Commit und bewahren Sie den Fix, die Verifizierung und den PR-Beweis zusammen auf.";
"help.regression.start.title" = "Starten Sie eine Untersuchung";
"help.regression.start.1" = "Das Bekannte Gute muss ein Vorfahre des Bekannten Bösen sein. Jede Grenze akzeptiert ein Commit, ein Tag oder einen Branch. Die schlechte Grenze ist üblicherweise HEAD.";
"help.regression.start.2" = "Der Automatikmodus erfordert einen wiederholbaren Befehl. Der manuelle Modus eignet sich für Fehler, die eine Benutzeroberfläche, ein Gerät oder eine menschliche Beobachtung erfordern.";
"help.regression.start.3" = "GitGatto verwendet einen isolierten Git-Arbeitsbaum und halbiert ihn, ohne den Zweig oder HEAD im aktuellen Repository zu wechseln.";
"help.regression.start.4" = "Eine Untersuchung kann angehalten und nach dem erneuten Öffnen der App vom selben Arbeitsbaum und Kandidaten-Commit fortgesetzt werden.";
"help.regression.verdict.title" = "Automatische und manuelle Urteile";
"help.regression.verdict.1" = "Im automatischen Modus ist der Exit-Code 0 gut, 1–124 ist schlecht und 125 überspringt das aktuelle Commit.";
"help.regression.verdict.2" = "Exit-Code 126, 127 oder 128 und höher stoppt die Untersuchung mit der Originalausgabe, anstatt einen Commit falsch zu klassifizieren.";
"help.regression.verdict.3" = "Im manuellen Modus wird jeweils ein Kandidat präsentiert. Wählen Sie „Gut“, „Schlecht“ oder „Überspringen“, um mit derselben Halbierungssitzung fortzufahren.";
"help.regression.fix.title" = "Behebung und Beweise";
"help.regression.fix.1" = "Das Ergebnis behält den ersten fehlerhaften Commit, seine Zusammenfassung, das Bisect-Protokoll sowie die Dauer, den Exit-Code und die Ausgabe jeder Probe bei.";
"help.regression.fix.2" = "Fix mit Agent funktioniert nur auf dem isolierten Zweig. Sie können diesen Arbeitsbaum auch anzeigen und selbst bearbeiten.";
"help.regression.fix.3" = "Der automatische Modus führt den ursprünglichen Befehl erneut aus; Der manuelle Modus erfordert ein explizites Bestehen oder Nichtbestehen. Eine PR kann nicht erstellt werden, bevor der Fix abgeschlossen ist.";
"help.regression.fix.4" = "Commit and Create PR schreibt den isolierten Zweig fest, pusht den Ursprung und erstellt einen GitHub PR. Durch das Entfernen des Arbeitsbaums bleiben seine Beweise erhalten.";

"help.topic.github.title" = "GitHub Projekte";
"help.topic.github.summary" = "Suchen Sie nach Projekten und Entwicklern, lesen Sie die vollständige Dokumentation und den Code in der App und arbeiten Sie mit Pull-Anfragen.";
"help.github.discover.title" = "Entdecken und erhalten Sie Projekte";
"help.github.discover.1" = "Wechseln Sie zwischen Projekten und Personensuche. Benutzerergebnisse verwenden Fuzzy-Ranking und umfassen öffentliche Repositorys.";
"help.github.discover.2" = "Meine Projekte umfassen eigene, kollaborative und Organisations-Repositorys; Die täglichen Picks stammen aus aktuellen GitHub-Daten.";
"help.github.discover.3" = "Klonen behält das Quell-Repository lokal bei. Fork & Clone erstellt zunächst einen Fork im aktuellen Konto und lädt ihn dann herunter.";
"help.github.detail.title" = "Projektdetails";
"help.github.detail.1" = "Übersicht rendert README aus GitHub Markdown-HTML, einschließlich Tabellen, Code, Warnungen und Bilder.";
"help.github.detail.2" = "Repository-Dokumentation und Code-Links navigieren innerhalb der Projektdetails; Externe Seiten verwenden den In-App-Browser.";
"help.github.detail.3" = "Code durchsucht die Standardverzweigung nach Ordner und zeigt Textdateien an; Binärdateien können unter GitHub in der App geöffnet werden.";
"help.github.detail.4" = "Pull Requests zeigt Beschreibungen und Unterschiede an, lässt Agent eine Antwort entwerfen und veröffentlicht erst nach Bestätigung.";
"help.github.detail.5" = "Schreiben Sie einen README mit einer von vier Vorlagen neu und überprüfen Sie das gerenderte lokale Ergebnis sofort. „Commit & Apply“ schreibt nur README fest und pusht den aktuellen Zweig.";

"help.topic.agent.title" = "Agent";
"help.topic.agent.summary" = "Agent verwendet Ihr konfiguriertes lokales CLI, um das aktuelle Repository zu verstehen, Aufgaben auszuführen und Konversationen auf Projektebene beizubehalten.";
"help.agent.scope.title" = "Repository-Grenze";
"help.agent.scope.1" = "Die professionellen Geräte Git und GitHub Agent können Arbeitsbaum, Staging, Patches, Verlauf, Verzweigungen, Konflikte, Pull-Requests und GitHub-Aktionsnachweise überprüfen.";
"help.agent.scope.2" = "Gestaffelte Überprüfungen und Commit-Entwürfe aktualisieren zunächst das ausgewählte Projekt und lesen dann den echten Git-Diff --cached.";
"help.agent.scope.3" = "Agent führt kein Push, Pull, Ändern von Fernbedienungen oder Verwalten von Anmeldeinformationen durch; explizite App-Steuerelemente besitzen diese Aktionen.";
"help.agent.workflow.title" = "Gespräch und Ergebnisse";
"help.agent.workflow.1" = "Mit Schnellaufgaben können Sie Änderungen erläutern, die Bereitstellung überprüfen oder eine Commit-Nachricht verfassen, und Sie können eine bestimmte Anfrage direkt eingeben.";
"help.agent.workflow.2" = "Antworten verwenden Konversationsformatierung; Befehle, Dateiänderungen, Modus und Abschlusszeit bleiben bei jedem Ergebnis erhalten.";
"help.agent.workflow.3" = "Jedes lokale Repository verfügt über einen separaten Konversationsverlauf, der zurückgegeben wird, wenn das Projekt erneut geöffnet wird.";
"help.agent.workflow.4" = "Entwurf aus dem Agent-Arbeitsbereich oder direkt unter Staging; Prägnante und vollständige Formate sind konfigurierbar und der Composer wird automatisch ausgefüllt.";

"help.topic.translation.title" = "Übersetzung";
"help.topic.translation.summary" = "Die Eingabeaufforderungs- und Projektdokumentübersetzung läuft unabhängig von Agent und behält wiederverwendbare README-Übersetzungen bei.";
"help.translation.document.title" = "Dokumentübersetzung";
"help.translation.document.1" = "README-Übersetzung sendet nur sichtbaren Text; HTML, Code, Links und Asset-Adressen bleiben unverändert und werden an Ort und Stelle wiederhergestellt.";
"help.translation.document.2" = "Übersetzungen sind nach Repository, Pfad, Zielsprache und Quellinhalt kodiert, sodass in geänderten Dokumenten niemals veralteter Text wiederverwendet wird.";
"help.translation.document.3" = "Wechseln Sie in der Symbolleiste zwischen Original, Chinesisch und Englisch. Gespeicherte Übersetzungen rufen den CLI nicht erneut auf.";
"help.translation.channel.title" = "Unabhängige Ausführungsspur";
"help.translation.channel.1" = "Übersetzung CLI und Projekt Agent verfügen über separate Konfigurationen und Prozesse, sodass die Übersetzung verfügbar bleibt, während Agent funktioniert.";
"help.translation.channel.2" = "Composer und README-Übersetzung teilen sich die Übersetzungsspur und verarbeiten jeweils eine Übersetzungsaufgabe.";
"help.translation.channel.3" = "Die Übersetzung kann gestoppt werden und hat eine Zeitüberschreitung; Bei Fehlern werden bereits gespeicherte Übersetzungen nicht gelöscht.";

"help.topic.cliSettings.title" = "Einstellungen";
"help.topic.cliSettings.summary" = "Konfigurieren Sie die App-Schnittstelle, den Startarbeitsbereich, die Live-Git-Überwachung, Agent und die Übersetzung in einem Fenster.";
"help.cliSettings.providers.title" = "App und Git";
"help.cliSettings.providers.1" = "Das Erscheinungsbild steuert den Hell- und Dunkelmodus, vollständige Schnittstellenthemen sowie voreingestellte oder benutzerdefinierte Akzente. Ein Design ändert das Fensterlayout, die Bedienfeldmaterialien und den Steuerelementstil zusammen.";
"help.cliSettings.providers.2" = "Allgemein steuert die Sprache der Benutzeroberfläche, den Startarbeitsbereich und das erneute Öffnen des letzten lokalen Repositorys; Speichern und prüfen behält diese Einstellungen bei.";
"help.cliSettings.providers.3" = "Git & Sync-Links zu manuellem Scannen, lokaler Staging-Aktualisierung, schreibgeschützter Upstream-Aktualisierung und Verwerfungsbestätigung; Es scannt, zieht oder drückt nie automatisch.";
"help.cliSettings.arguments.title" = "Agent und Übersetzung";
"help.cliSettings.arguments.1" = "Agent wählt den prägnanten oder vollständigen Commit-Entwurf aus und konfiguriert seinen Projektausführer.";
"help.cliSettings.arguments.2" = "Die Übersetzung verfügt über einen separaten Executor, Prozess und Argumente, sodass sie verfügbar bleibt, während Agent funktioniert.";
"help.cliSettings.arguments.3" = "Voreinstellungen umfassen Codex CLI, Claude Code, Gemini CLI und OpenCode; Benutzerdefiniert akzeptiert alle kompatiblen CLI mit einem Argument pro Zeile.";
"help.cliSettings.arguments.4" = "GitGatto verwendet die eigene lokale Anmeldung jedes CLI wieder und liest oder speichert niemals seine Anmeldeinformationen.";

"help.topic.shortcuts.title" = "Tastaturkürzel";
"help.topic.shortcuts.summary" = "Navigieren Sie durch die App und führen Sie allgemeine Repository-Aktionen direkt über die Tastatur aus.";
"help.shortcuts.workspace.title" = "Arbeitsbereiche wechseln";
"help.shortcuts.workspace.1" = "⌘1: Projekte";
"help.shortcuts.workspace.2" = "⌘2: Änderungen";
"help.shortcuts.workspace.3" = "⌘3: Geschichte";
"help.shortcuts.workspace.4" = "⌘4: Zweige; ⌘5: Agent";
"help.shortcuts.workspace.5" = "⌘?: GitGatto-Hilfe öffnen";
"help.shortcuts.actions.title" = "Gemeinsame Aktionen";
"help.shortcuts.actions.1" = "⌘O: Öffnen Sie ein lokales Repository; ⌘R: Aktualisieren Sie das aktuelle Repository.";
"help.shortcuts.actions.2" = "⌘↩: Übertragen Sie bereitgestellte Inhalte mit der aktuellen Commit-Nachricht.";
"help.shortcuts.actions.3" = "Klicken Sie mit der rechten Maustaste auf eine geänderte Datei oder ein aktuelles Repository, um das vollständige objektspezifische Menü anzuzeigen.";

"help.topic.troubleshooting.title" = "Fehlerbehebung";
"help.topic.troubleshooting.summary" = "Bestätigen Sie das ausgewählte Projekt, die lokale CLI-Anmeldung und den gemeldeten Fehler, bevor Sie den fehlgeschlagenen Vorgang erneut versuchen.";
"help.troubleshooting.access.title" = "CLI und Kontozugriff";
"help.troubleshooting.access.1" = "Wenn GitHub nicht verfügbar ist, starten Sie die Anmeldung über Projekte oder schließen Sie die GH-Authentifizierung im Terminal ab.";
"help.troubleshooting.access.2" = "Wenn Agent nicht verfügbar ist, überprüfen Sie seine ausführbare Datei, Versionsargumente und die eigene lokale Anmeldung des CLI unter Einstellungen > Agent.";
"help.troubleshooting.access.3" = "Wenn ein benutzerdefiniertes CLI keinen Versionsbefehl hat, deaktivieren Sie die Versionsprüfung. Save & Check überprüft weiterhin, ob die ausführbare Datei vorhanden ist.";
"help.troubleshooting.operations.title" = "Fehlgeschlagene Vorgänge";
"help.troubleshooting.operations.1" = "Wenn ein Projekt fehlt, verwenden Sie „Nach Projekten suchen“; Repositorys, die der aktuelle Benutzer nicht lesen, schreiben und durchqueren kann, werden nicht hinzugefügt. Bestätigen Sie bei veraltetem Staging das ausgewählte Projekt und aktualisieren Sie es.";
"help.troubleshooting.operations.2" = "Bei einem fehlgeschlagenen Push bleibt der lokale Commit bestehen. Lösen Sie Remote-, Berechtigungs- oder Netzwerkprobleme und verwenden Sie dann Push erneut.";
"help.troubleshooting.operations.3" = "Repositorys, die Git LFS verwenden, erfordern git-lfs; Entfernen Sie den LFS-Hook des Repositorys, wenn LFS nicht mehr verwendet wird.";
"help.troubleshooting.operations.4" = "Wiederholen Sie eine abgelaufene oder gestoppte Übersetzung. Gespeicherte Übersetzungen bleiben auswählbar, während die Quelle unverändert bleibt.";
"help.troubleshooting.operations.5" = "Bei Git- und Agent-Fehlern bleiben die vollständige Ausgabe, der Fehlercode und der Exit-Code erhalten. Verwenden Sie Copy Diagnostics, wenn Sie Nachforschungen anstellen müssen.";

