"codex.prompt.explain_changes" = "Erklären Sie die aktuellen Änderungen im Arbeitsbaum. Fassen Sie den Zweck und die Auswirkungen pro Datei zusammen und identifizieren Sie Risiken, die Aufmerksamkeit erfordern.";
"codex.prompt.review_staged" = "Überprüfen Sie die bereitgestellten Änderungen. Priorisieren Sie konkrete Erkenntnisse, die Fehler, Datenverlust oder Kompatibilitätsprobleme verursachen könnten.";
"codex.prompt.draft_commit.concise" = "Erstellen Sie eine genaue, spezifische Git-Commit-Zusammenfassung aus den inszenierten Änderungen in nicht mehr als 72 Zeichen. Gibt nur eine Zeile zurück.";
"codex.prompt.draft_commit.complete" = "Entwerfen Sie eine vollständige Git-Commit-Nachricht aus den inszenierten Änderungen: eine Zusammenfassung von nicht mehr als 72 Zeichen, dann eine Leerzeile und 1–3 kurze Textpunkte, in denen Motivation und Wirkung erläutert werden. Gibt nur die Commit-Nachricht zurück.";
"codex.prompt.rewrite_commit.concise" = "Schreiben Sie die aktuell bereitgestellten Änderungen in eine genauere, spezifischere einzeilige Git-Commit-Zusammenfassung mit nicht mehr als 72 Zeichen um. Geben Sie nur die neue Nachricht zurück.";
"codex.prompt.rewrite_commit.complete" = "Schreiben Sie die aktuell bereitgestellten Änderungen als vollständige Git-Commit-Nachricht um: eine Zusammenfassung von nicht mehr als 72 Zeichen und einen kurzen Text, in dem Motivation und Auswirkungen erläutert werden. Geben Sie nur die neue Nachricht zurück.";
"codex.prompt.diagnose_repository" = "Untersuchen Sie den aktuellen Repository-Status auf Arbeitsbaum-, Index-, Zweig-, Hook-, Git LFS-, Submodul- oder Arbeitsbaumprobleme und geben Sie evidenzbasierte Wiederherstellungsschritte an. Ändern Sie das Repository nicht.";
"codex.prompt.diagnose_sync" = "Untersuchen Sie den aktuellen Zweig, den Upstream und den Ahead/Behind-Status und diagnostizieren Sie wahrscheinliche Pull- oder Push-Fehler. Führen Sie keine Remote-Schreibvorgänge durch.";
"codex.prompt.diagnose_conflicts" = "Überprüfen Sie, ob sich das Repository in einem Merge-, Rebase-, Cherry-Pick-, Revert- oder Stash-Konflikt befindet, und listen Sie die Konfliktgrenzen und die sichere Lösungsreihenfolge auf. Ändern Sie das Repository nicht.";
"codex.prompt.trace_history" = "Verfolgen Sie aktuelle Änderungen, Zweigbeziehungen und wahrscheinliche Regressionsquellen aus dem Repository-Verlauf mit überprüfbaren Commit- und Dateinachweisen. Ändern Sie das Repository nicht.";
"codex.prompt.diagnose_github_checks" = "Lesen Sie den Pull-Request des aktuellen Repositorys und die GitHub-Aktionen prüfen die Ergebnisse und identifizieren Sie den fehlgeschlagenen Schritt und seine Beziehung zu lokalen Änderungen. Halten Sie GitHub schreibgeschützt.";
"codex.prompt.resolve_error.display" = "Beheben Sie den Git-Fehler %@";
